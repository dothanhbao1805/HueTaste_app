<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Basic" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/ActivityAnimation</item>
        <!-- Customize your theme here. -->
        <item name="colorAccent">@color/toolsThemeLight</item>
        <item name="android:textColorPrimary">@color/textPrimaryLight</item>
        <item name="android:textColorSecondary">@color/textSecondaryLight</item>
        <item name="android:textColorTertiary">@color/textTertiaryLight</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:statusBarColor">@color/backgroundLight</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/backgroundLight</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryLight</item>
        <item name="colorOnPrimary">@color/textPrimaryLight</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondaryLight</item>
        <item name="colorOnSecondary">@color/textSecondaryLight</item>
        <!-- Tertiary brand color. -->
        <item name="colorTertiary">@color/tertiaryLight</item>
        <item name="colorOnTertiary">@color/textTertiaryLight</item>
        <item name="materialAlertDialogTheme">@style/DialogLight</item>
    </style>

    <style name="ActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="DialogLight" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/cardBackgroundLight</item>
        <item name="materialAlertDialogTitleTextStyle">@style/BodyMaterialAlertDialog.MaterialComponents.Title.Text</item>
        <item name="materialAlertDialogBodyTextStyle">@style/BodyMaterialAlertDialog.MaterialComponents.Body.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/ButtonStyleLight</item>
        <item name="buttonBarPositiveButtonStyle">@style/ButtonStyleLight</item>
    </style>

    <style name="BodyMaterialAlertDialog.MaterialComponents.Title.Text" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/textPrimaryLight</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BodyMaterialAlertDialog.MaterialComponents.Body.Text" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/textSecondaryLight</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="ButtonStyleLight" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/toolsThemeLight</item>
    </style>

    <style name="DialogDark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/cardBackgroundDark</item>
        <item name="materialAlertDialogTitleTextStyle">@style/BodyMaterialAlertDialog.MaterialComponents.Title.Text.Dark</item>
        <item name="materialAlertDialogBodyTextStyle">@style/BodyMaterialAlertDialog.MaterialComponents.Body.Text.Dark</item>
        <item name="buttonBarNegativeButtonStyle">@style/ButtonStyleDark</item>
        <item name="buttonBarPositiveButtonStyle">@style/ButtonStyleDark</item>
    </style>

    <style name="BodyMaterialAlertDialog.MaterialComponents.Title.Text.Dark" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/textPrimaryDark</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BodyMaterialAlertDialog.MaterialComponents.Body.Text.Dark" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/textSecondaryDark</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="ButtonStyleDark" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/toolsThemeDark</item>
    </style>

</resources>