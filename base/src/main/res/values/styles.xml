<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="circle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="corner_7dp">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_7sdp</item>
    </style>

    <style name="corner_10dp">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_10sdp</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="BottomSheetFragmentStyle" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background_main</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="colorAccent">@color/toolsThemeDark</item>
        <item name="colorPrimary">@color/primaryLight</item>
    </style>

    <style name="BottomSheetFragmentStyleWhite" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:navigationBarColor">@color/background_main</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="colorAccent">@color/toolsThemeDark</item>
        <item name="colorPrimary">@color/background_main</item>
    </style>

    <style name="BottomSheetFragmentStyleBgLight" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background_main</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="colorAccent">@color/toolsThemeDark</item>
        <item name="colorPrimary">@color/primaryLight</item>
    </style>

    <style name="BottomSheetFragmentStyleAdjustResize" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize|stateVisible</item>
        <item name="android:navigationBarColor">@color/background_main</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="colorAccent">@color/toolsThemeDark</item>
        <item name="colorPrimary">@color/primaryLight</item>
    </style>

