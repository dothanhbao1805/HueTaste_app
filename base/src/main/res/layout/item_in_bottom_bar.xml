<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsLinearView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:rippleBackground="rippleBorderless">

    <com.base.common.widget.LsConstraintView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <com.base.common.widget.LsCardView
            android:id="@+id/viewIndicator"
            style="@style/CardCorner.50Percent"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toTopOf="@id/display"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <com.base.common.widget.LsConstraintView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.base.common.widget.LsImageView
                    android:id="@+id/preview"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.8"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@tools:sample/avatars" />

            </com.base.common.widget.LsConstraintView>

        </com.base.common.widget.LsCardView>

        <com.base.common.widget.LsTextView
            android:id="@+id/display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:textColor="textPrimary"
            app:textSize="tertiary"
            tools:text="@tools:sample/full_names" />

    </com.base.common.widget.LsConstraintView>

</com.base.common.widget.LsLinearView>