<?xml version="1.0" encoding="utf-8"?>
<!-- Pill input container: the outline turns primary while it has focus (activated) and red on error (selected). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hue_surface_lowest" />
            <stroke
                android:width="@dimen/_2dp"
                android:color="@color/hue_error" />
            <corners android:radius="@dimen/_100dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hue_surface_lowest" />
            <stroke
                android:width="@dimen/_2dp"
                android:color="@color/hue_primary" />
            <corners android:radius="@dimen/_100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hue_surface_lowest" />
            <stroke
                android:width="@dimen/_1dp"
                android:color="@color/hue_outline_hairline" />
            <corners android:radius="@dimen/_100dp" />
        </shape>
    </item>
</selector>
