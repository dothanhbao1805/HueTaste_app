<?xml version="1.0" encoding="utf-8"?>
<!-- Budget tile of "Nhu cầu hôm nay": filled with the primary color while selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hue_primary" />
            <corners android:radius="@dimen/_12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hue_surface_container_low" />
            <corners android:radius="@dimen/_12dp" />
        </shape>
    </item>
</selector>
