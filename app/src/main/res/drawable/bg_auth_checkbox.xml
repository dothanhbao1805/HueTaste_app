<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hue_primary" />
            <corners android:radius="@dimen/_6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hue_surface_lowest" />
            <stroke
                android:width="@dimen/_2dp"
                android:color="@color/hue_primary" />
            <corners android:radius="@dimen/_6dp" />
        </shape>
    </item>
</selector>
