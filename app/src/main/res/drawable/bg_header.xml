<?xml version="1.0" encoding="utf-8"?>
<!-- Top bars: the surface with a hairline along the bottom only. An elevation shadow would also show along the
     top edge, as a line under the status bar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hue_surface" />
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:height="@dimen/_1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hue_outline_hairline" />
        </shape>
    </item>
</layer-list>
