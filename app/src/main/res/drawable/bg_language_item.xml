<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the language list: filled with the primary color while selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hue_primary" />
            <corners android:radius="@dimen/_12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hue_surface_lowest" />
            <stroke
                android:width="@dimen/_1dp"
                android:color="@color/hue_outline_hairline" />
            <corners android:radius="@dimen/_12dp" />
        </shape>
    </item>
</selector>
