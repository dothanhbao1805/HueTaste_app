<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for devices older than API 31 (see data_extraction_rules.xml for newer ones).
   The signed-in session is encrypted with a key that exists only on this device, so a restored copy could never be
   read; keep it out of backups instead of restoring unreadable data.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="auth_session.xml" />
</full-backup-content>
