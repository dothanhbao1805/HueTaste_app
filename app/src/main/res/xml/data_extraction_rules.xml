<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for API 31 and newer.
   The signed-in session is encrypted with a key that exists only on this device, so it is never copied elsewhere.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="auth_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="auth_session.xml" />
    </device-transfer>
</data-extraction-rules>
