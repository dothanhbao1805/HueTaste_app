<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.HueTaste" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
    </style>

    <style name="Theme.HueTaste" parent="Base.Theme.HueTaste" />

    <!-- Launch theme: the window shows the splash background right away instead of a white flash. -->
    <style name="Theme.HueTaste.Splash" parent="Theme.HueTaste">
        <item name="android:windowBackground">@color/hue_surface</item>
    </style>
</resources>
