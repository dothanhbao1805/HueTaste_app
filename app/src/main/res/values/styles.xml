<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.HueTaste.BottomNavigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">@dimen/main_navigation_text_size</item>
    </style>

    <style name="ShapeAppearance.HueTaste.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.HueTaste.Rounded12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_12dp</item>
    </style>

    <style name="ShapeAppearance.HueTaste.Rounded8" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_8dp</item>
    </style>

    <!-- Stitch budget range: flat 8dp surface-container track with a round 16dp primary thumb. -->
    <style name="ShapeAppearance.HueTaste.BottomRounded32" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/_0dp</item>
        <item name="cornerSizeTopRight">@dimen/_0dp</item>
        <item name="cornerSizeBottomLeft">@dimen/_32dp</item>
        <item name="cornerSizeBottomRight">@dimen/_32dp</item>
    </style>

    <style name="Widget.HueTaste.BudgetSlider" parent="Widget.Material3.Slider">
        <item name="labelBehavior">gone</item>
        <item name="tickVisible">false</item>
        <item name="trackColorActive">@color/hue_surface_container</item>
        <item name="trackColorInactive">@color/hue_surface_container</item>
        <item name="trackHeight">@dimen/_8dp</item>
        <item name="trackInsideCornerSize">@dimen/_4dp</item>
        <item name="trackStopIndicatorSize">@dimen/_0dp</item>
        <item name="thumbTrackGapSize">@dimen/_0dp</item>
        <item name="thumbColor">@color/hue_primary</item>
        <item name="thumbWidth">@dimen/_16dp</item>
        <item name="thumbHeight">@dimen/_16dp</item>
        <item name="thumbElevation">@dimen/_0dp</item>
        <!-- The halo is the slider's circular touch ripple; keep it tight around the thumb. -->
        <item name="haloColor">@color/hue_primary_20</item>
        <item name="haloRadius">@dimen/_16dp</item>
    </style>

    <!-- One option of the taste setup spiciness control: an equal-width pill that fills primary while selected. -->
    <style name="TasteSetupSegment">
        <item name="android:foreground">@drawable/fg_ripple_pill</item>
        <item name="android:layout_width">@dimen/_0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_context_segment</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:minHeight">@dimen/_44dp</item>
        <item name="android:paddingHorizontal">@dimen/_6dp</item>
        <item name="android:paddingVertical">@dimen/_6dp</item>
        <item name="android:textColor">@color/context_segment_content</item>
        <item name="android:textSize">@dimen/text_12sp</item>
        <item name="textFont">semi</item>
    </style>

    <!-- One budget option of the taste setup: an equal-width pill in a two-column grid. -->
    <style name="TasteSetupBudget">
        <item name="android:foreground">@drawable/fg_ripple_pill</item>
        <item name="android:layout_width">@dimen/_0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_home_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/_48dp</item>
        <item name="android:paddingHorizontal">@dimen/_12dp</item>
        <item name="android:paddingVertical">@dimen/_6dp</item>
        <item name="android:textColor">@color/home_chip_text</item>
        <item name="android:textSize">@dimen/text_14sp</item>
        <item name="textFont">semi</item>
    </style>

    <!-- "Nhu cầu hôm nay": one white section card. -->
    <style name="DailyNeedsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_shape_round_16</item>
        <item name="android:backgroundTint">@color/hue_surface_lowest</item>
        <item name="android:elevation">@dimen/_2dp</item>
        <item name="android:outlineAmbientShadowColor">@color/hue_card_shadow</item>
        <item name="android:outlineSpotShadowColor">@color/hue_card_shadow</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/_14dp</item>
    </style>

    <style name="DailyNeedsCardIcon">
        <item name="android:layout_width">@dimen/_36dp</item>
        <item name="android:layout_height">@dimen/_36dp</item>
        <item name="android:background">@drawable/bg_shape_circle</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:padding">@dimen/_8dp</item>
    </style>

    <style name="DailyNeedsCardTitle">
        <item name="android:layout_width">@dimen/_0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/_10dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/hue_on_surface</item>
        <item name="android:textSize">@dimen/text_16sp</item>
        <item name="textFont">semi</item>
    </style>

    <!-- "+ Không cay"-style pill that adds a phrase to the note. -->
    <style name="DailyNeedsQuickNote">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_shape_pill</item>
        <item name="android:backgroundTint">@color/hue_surface_container</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">@drawable/fg_ripple_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/_12dp</item>
        <item name="android:paddingVertical">@dimen/_6dp</item>
        <item name="android:textColor">@color/hue_on_surface_variant</item>
        <item name="android:textSize">@dimen/text_11sp</item>
        <item name="textFont">medium</item>
    </style>

    <!-- "Lịch sử scan món": a filter pill; the selected state comes from isSelected. -->
    <style name="ScanHistoryFilter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_home_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">@drawable/fg_ripple_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/_40dp</item>
        <item name="android:paddingHorizontal">@dimen/_16dp</item>
        <item name="android:paddingVertical">@dimen/_6dp</item>
        <item name="android:textColor">@color/home_chip_text</item>
        <item name="android:textSize">@dimen/text_12sp</item>
        <item name="textFont">medium</item>
    </style>

    <!-- A centered empty or error state over the list. -->
    <style name="ScanHistoryState">
        <item name="android:layout_width">@dimen/_0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">@dimen/_10dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="ScanHistoryStateTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/hue_on_surface</item>
        <item name="android:textSize">@dimen/text_18sp</item>
        <item name="textFont">bold</item>
    </style>

    <style name="ScanHistoryStateMessage">
        <item name="android:layout_width">@dimen/_260dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/hue_on_surface_variant</item>
        <item name="android:textSize">@dimen/text_14sp</item>
        <item name="textFont">regular</item>
    </style>

    <!-- Primary pill with an icon and a label. -->
    <style name="ScanHistoryPrimaryButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/_48dp</item>
        <item name="android:background">@drawable/bg_shape_pill</item>
        <item name="android:backgroundTint">@color/hue_primary</item>
        <item name="android:foreground">@drawable/fg_ripple_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/_20dp</item>
    </style>

    <style name="ScanHistoryPrimaryButtonText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/_8dp</item>
        <item name="android:textColor">@color/hue_on_primary</item>
        <item name="android:textSize">@dimen/text_14sp</item>
        <item name="textFont">semi</item>
    </style>
</resources>
