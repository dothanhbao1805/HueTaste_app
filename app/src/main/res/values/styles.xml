<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.HueTaste.BottomNavigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">@dimen/main_navigation_text_size</item>
    </style>

    <style name="ShapeAppearance.HueTaste.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.HueTaste.Rounded12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_12dp</item>
    </style>

    <style name="ShapeAppearance.HueTaste.Rounded8" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_8dp</item>
    </style>

    <!-- Stitch budget range: flat 8dp surface-container track with a round 16dp primary thumb. -->
    <style name="ShapeAppearance.HueTaste.BottomRounded32" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/_0dp</item>
        <item name="cornerSizeTopRight">@dimen/_0dp</item>
        <item name="cornerSizeBottomLeft">@dimen/_32dp</item>
        <item name="cornerSizeBottomRight">@dimen/_32dp</item>
    </style>

    <style name="Widget.HueTaste.BudgetSlider" parent="Widget.Material3.Slider">
        <item name="labelBehavior">gone</item>
        <item name="tickVisible">false</item>
        <item name="trackColorActive">@color/hue_surface_container</item>
        <item name="trackColorInactive">@color/hue_surface_container</item>
        <item name="trackHeight">@dimen/_8dp</item>
        <item name="trackInsideCornerSize">@dimen/_4dp</item>
        <item name="trackStopIndicatorSize">@dimen/_0dp</item>
        <item name="thumbTrackGapSize">@dimen/_0dp</item>
        <item name="thumbColor">@color/hue_primary</item>
        <item name="thumbWidth">@dimen/_16dp</item>
        <item name="thumbHeight">@dimen/_16dp</item>
        <item name="thumbElevation">@dimen/_0dp</item>
        <!-- The halo is the slider's circular touch ripple; keep it tight around the thumb. -->
        <item name="haloColor">@color/hue_primary_20</item>
        <item name="haloRadius">@dimen/_16dp</item>
    </style>

    <!-- One option of the taste setup spiciness control: an equal-width pill that fills primary while selected. -->
    <style name="TasteSetupSegment">
        <item name="android:foreground">@drawable/fg_ripple_pill</item>
        <item name="android:layout_width">@dimen/_0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_context_segment</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:minHeight">@dimen/_44dp</item>
        <item name="android:paddingHorizontal">@dimen/_6dp</item>
        <item name="android:paddingVertical">@dimen/_6dp</item>
        <item name="android:textColor">@color/context_segment_content</item>
        <item name="android:textSize">@dimen/text_12sp</item>
        <item name="textFont">semi</item>
    </style>

    <!-- One budget option of the taste setup: an equal-width pill in a two-column grid. -->
    <style name="TasteSetupBudget">
        <item name="android:foreground">@drawable/fg_ripple_pill</item>
        <item name="android:layout_width">@dimen/_0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_home_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/_48dp</item>
        <item name="android:paddingHorizontal">@dimen/_12dp</item>
        <item name="android:paddingVertical">@dimen/_6dp</item>
        <item name="android:textColor">@color/home_chip_text</item>
        <item name="android:textSize">@dimen/text_14sp</item>
        <item name="textFont">semi</item>
    </style>
</resources>
