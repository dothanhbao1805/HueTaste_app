<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsConstraintView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hue_surface"
    tools:context=".feature.main.MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/statusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/navigationBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="0dp" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        app:layout_constraintTop_toTopOf="@id/statusBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.base.common.widget.LsConstraintView
        android:id="@+id/bottomBar"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        app:layout_constraintBottom_toBottomOf="@id/navigationBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="@dimen/_0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/_64dp"
            android:background="@android:color/transparent"
            app:itemActiveIndicatorStyle="@null"
            app:itemBackground="@drawable/bg_bottom_navigation_item"
            app:itemHorizontalTranslationEnabled="false"
            app:itemIconSize="@dimen/_24dp"
            app:itemPaddingBottom="@dimen/_12dp"
            app:itemPaddingTop="@dimen/_12dp"
            app:itemIconTint="@color/bottom_navigation_item_color"
            app:itemTextColor="@color/bottom_navigation_item_color"
            app:itemTextAppearanceActive="@style/TextAppearance.HueTaste.BottomNavigation"
            app:itemTextAppearanceInactive="@style/TextAppearance.HueTaste.BottomNavigation"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_main_bottom_navigation"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </com.base.common.widget.LsConstraintView>

    <com.base.common.widget.LsLinearView
        android:id="@+id/centerAiButton"
        android:foreground="@drawable/fg_ripple_circle"
        android:layout_width="@dimen/_56dp"
        android:layout_height="@dimen/_56dp"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_ai_center"
        android:clickable="true"
        android:elevation="@dimen/_8dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingBottom="@dimen/_2dp"
        android:contentDescription="@string/tab_ai_assistant"
        app:layout_constraintTop_toTopOf="@id/bottomBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_14dp">

        <com.base.common.widget.LsImageView
            android:id="@+id/centerAiIcon"
            android:layout_width="@dimen/_24dp"
            android:layout_height="@dimen/_24dp"
            android:src="@drawable/ic_auto_awesome"
            android:tint="@color/white"
            android:importantForAccessibility="no" />

        <com.base.common.widget.LsTextView
            android:id="@+id/centerAiLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_ai_assistant"
            android:textColor="@color/white"
            android:textSize="@dimen/text_11sp"
            app:textFont="bold" />

    </com.base.common.widget.LsLinearView>

</com.base.common.widget.LsConstraintView>