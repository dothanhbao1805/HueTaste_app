<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <com.base.common.widget.LsLinearView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_10dp"
        android:paddingBottom="@dimen/_24dp">

        <include
            android:id="@+id/badge"
            layout="@layout/view_taste_badge" />

        <com.base.common.widget.LsTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12dp"
            android:text="@string/taste_flavor_title"
            android:textColor="@color/hue_on_surface"
            android:textSize="@dimen/text_24sp"
            app:textFont="bold" />

        <com.base.common.widget.LsTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:text="@string/taste_flavor_subtitle"
            android:textColor="@color/hue_on_surface_variant"
            android:textSize="@dimen/text_14sp"
            app:textFont="regular" />

        <com.base.common.widget.LsLinearView
            android:id="@+id/spiceSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.base.common.widget.LsLinearView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.base.common.widget.LsTextView
                    android:layout_width="@dimen/_0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/taste_spice_title"
                    android:textColor="@color/hue_on_surface"
                    android:textSize="@dimen/text_18sp"
                    app:textFont="bold" />

                <com.base.common.widget.LsImageView
                    android:layout_width="@dimen/_16dp"
                    android:layout_height="@dimen/_16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_local_fire_department"
                    android:tint="@color/hue_primary" />

                <com.base.common.widget.LsTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4dp"
                    android:text="@string/taste_spice_hint"
                    android:textColor="@color/hue_primary"
                    android:textSize="@dimen/text_12sp"
                    app:textFont="medium" />

            </com.base.common.widget.LsLinearView>

            <com.base.common.widget.LsLinearView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                android:background="@drawable/bg_shape_pill"
                android:backgroundTint="@color/hue_surface_container"
                android:orientation="horizontal"
                android:padding="@dimen/_4dp">

                <com.base.common.widget.LsTextView
                    android:id="@+id/spiceNone"
                    style="@style/TasteSetupSegment"
                    android:text="@string/taste_spice_none" />

                <com.base.common.widget.LsTextView
                    android:id="@+id/spiceMild"
                    style="@style/TasteSetupSegment"
                    android:text="@string/taste_spice_mild" />

                <com.base.common.widget.LsTextView
                    android:id="@+id/spiceMedium"
                    style="@style/TasteSetupSegment"
                    android:text="@string/taste_spice_medium" />

                <com.base.common.widget.LsTextView
                    android:id="@+id/spiceHue"
                    style="@style/TasteSetupSegment"
                    android:text="@string/taste_spice_hue" />

            </com.base.common.widget.LsLinearView>

        </com.base.common.widget.LsLinearView>

        <com.base.common.widget.LsLinearView
            android:id="@+id/flavorSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/flavorHeader"
                layout="@layout/view_taste_section_header" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/flavorGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                app:chipSpacingHorizontal="@dimen/_8dp"
                app:chipSpacingVertical="@dimen/_8dp" />

        </com.base.common.widget.LsLinearView>

        <com.base.common.widget.LsLinearView
            android:id="@+id/styleSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/styleHeader"
                layout="@layout/view_taste_section_header" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/styleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                app:chipSpacingHorizontal="@dimen/_8dp"
                app:chipSpacingVertical="@dimen/_8dp" />

        </com.base.common.widget.LsLinearView>

        <include
            android:id="@+id/status"
            layout="@layout/view_taste_status" />

    </com.base.common.widget.LsLinearView>

</androidx.core.widget.NestedScrollView>
