<?xml version="1.0" encoding="utf-8"?>
<!-- A placeholder result card shown while the first page loads. -->
<com.base.common.widget.LsCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_12dp"
    android:importantForAccessibility="noHideDescendants"
    app:cardBackgroundColor="@color/hue_surface_lowest"
    app:cardCornerRadius="@dimen/_16dp"
    app:cardElevation="@dimen/_0dp"
    app:strokeColor="@color/hue_outline_hairline"
    app:strokeWidth="@dimen/_1dp">

    <com.base.common.widget.LsLinearView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_12dp">

        <com.base.common.widget.LsView
            android:layout_width="@dimen/_96dp"
            android:layout_height="@dimen/_96dp"
            android:background="@drawable/bg_shape_round_12"
            android:backgroundTint="@color/hue_surface_container_highest" />

        <com.base.common.widget.LsLinearView
            android:layout_width="@dimen/_0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.base.common.widget.LsView
                android:layout_width="@dimen/_160dp"
                android:layout_height="@dimen/_16dp"
                android:layout_marginTop="@dimen/_4dp"
                android:background="@drawable/bg_shape_round_4"
                android:backgroundTint="@color/hue_surface_container_highest" />

            <com.base.common.widget.LsView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_12dp"
                android:layout_marginTop="@dimen/_12dp"
                android:background="@drawable/bg_shape_round_4"
                android:backgroundTint="@color/hue_surface_container" />

            <com.base.common.widget.LsView
                android:layout_width="@dimen/_120dp"
                android:layout_height="@dimen/_12dp"
                android:layout_marginTop="@dimen/_6dp"
                android:background="@drawable/bg_shape_round_4"
                android:backgroundTint="@color/hue_surface_container" />

            <com.base.common.widget.LsView
                android:layout_width="@dimen/_80dp"
                android:layout_height="@dimen/_16dp"
                android:layout_marginTop="@dimen/_16dp"
                android:background="@drawable/bg_shape_round_4"
                android:backgroundTint="@color/hue_surface_container_highest" />

        </com.base.common.widget.LsLinearView>

    </com.base.common.widget.LsLinearView>

</com.base.common.widget.LsCardView>
