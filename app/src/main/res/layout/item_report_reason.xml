<?xml version="1.0" encoding="utf-8"?>
<!-- One reason of the place report sheet: a title and a round single-choice check; selection comes from isSelected. -->
<com.base.common.widget.LsConstraintView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:foreground="@drawable/fg_ripple_round_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_8dp"
    android:background="@drawable/bg_taste_option"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/_52dp"
    android:paddingHorizontal="@dimen/_16dp"
    android:paddingVertical="@dimen/_12dp">

    <com.base.common.widget.LsTextView
        android:id="@+id/reasonTitle"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_12dp"
        android:textColor="@color/hue_on_surface"
        android:textSize="@dimen/text_14sp"
        app:textFont="medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/reasonCheck"
        tools:text="Quán đã đóng cửa" />

    <com.base.common.widget.LsImageView
        android:id="@+id/reasonCheck"
        android:layout_width="@dimen/_22dp"
        android:layout_height="@dimen/_22dp"
        android:background="@drawable/bg_report_radio"
        android:importantForAccessibility="no"
        android:padding="@dimen/_3dp"
        android:src="@drawable/ic_check"
        android:tint="@color/auth_check_tint"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</com.base.common.widget.LsConstraintView>
