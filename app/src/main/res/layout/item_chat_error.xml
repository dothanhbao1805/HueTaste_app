<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsConstraintView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/_6dp">

    <com.base.common.widget.LsImageView
        android:id="@+id/avatarImage"
        android:layout_width="@dimen/_32dp"
        android:layout_height="@dimen/_32dp"
        android:layout_marginTop="@dimen/_4dp"
        android:background="@drawable/bg_shape_circle"
        android:backgroundTint="@color/hue_error"
        android:importantForAccessibility="no"
        android:padding="@dimen/_7dp"
        android:src="@drawable/ic_auto_awesome"
        android:tint="@color/hue_on_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.base.common.widget.LsLinearView
        android:id="@+id/errorBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8dp"
        android:layout_marginEnd="@dimen/_32dp"
        android:background="@drawable/bg_chat_error"
        android:orientation="vertical"
        android:padding="@dimen/_14dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/avatarImage"
        app:layout_constraintTop_toTopOf="parent">

        <com.base.common.widget.LsTextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hue_on_error_container"
            android:textSize="@dimen/text_14sp"
            app:textFont="regular" />

        <com.base.common.widget.LsTextView
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10dp"
            android:background="@drawable/bg_shape_pill"
            android:backgroundTint="@color/hue_surface_lowest"
            android:foreground="@drawable/fg_ripple_pill"
            android:gravity="center"
            android:minHeight="@dimen/_36dp"
            android:paddingHorizontal="@dimen/_16dp"
            android:paddingVertical="@dimen/_6dp"
            android:text="@string/ai_chat_retry"
            android:textColor="@color/hue_error"
            android:textSize="@dimen/text_12sp"
            app:textFont="semi" />

    </com.base.common.widget.LsLinearView>

</com.base.common.widget.LsConstraintView>
