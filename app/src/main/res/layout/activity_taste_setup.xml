<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsConstraintView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tasteSetupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hue_surface"
    tools:context=".feature.taste_setup.TasteSetupActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/statusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/navigationBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="0dp" />

    <com.base.common.widget.LsConstraintView
        android:id="@+id/headerBar"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_64dp"
        android:background="@color/hue_surface"
        android:paddingHorizontal="@dimen/_10dp"
        app:layout_constraintTop_toTopOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.base.common.widget.LsImageView
            android:id="@+id/backButton"
            android:foreground="@drawable/fg_ripple_circle"
            android:layout_width="@dimen/_48dp"
            android:layout_height="@dimen/_48dp"
            android:contentDescription="@string/context_back"
            android:padding="@dimen/_12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/hue_on_surface"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.base.common.widget.LsLinearView
            android:id="@+id/progressBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.base.common.widget.LsTextView
                android:id="@+id/stepText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hue_on_surface_variant"
                android:textSize="@dimen/text_12sp"
                app:textFont="medium"
                tools:text="Bước 1/3" />

            <com.base.common.widget.LsLinearView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6dp"
                android:orientation="horizontal">

                <com.base.common.widget.LsView
                    android:id="@+id/stepBar1"
                    android:layout_width="@dimen/_32dp"
                    android:layout_height="@dimen/_4dp"
                    android:background="@drawable/bg_shape_pill"
                    android:backgroundTint="@color/hue_primary" />

                <com.base.common.widget.LsView
                    android:id="@+id/stepBar2"
                    android:layout_width="@dimen/_32dp"
                    android:layout_height="@dimen/_4dp"
                    android:layout_marginStart="@dimen/_6dp"
                    android:background="@drawable/bg_shape_pill"
                    android:backgroundTint="@color/hue_surface_container_high" />

                <com.base.common.widget.LsView
                    android:id="@+id/stepBar3"
                    android:layout_width="@dimen/_32dp"
                    android:layout_height="@dimen/_4dp"
                    android:layout_marginStart="@dimen/_6dp"
                    android:background="@drawable/bg_shape_pill"
                    android:backgroundTint="@color/hue_surface_container_high" />

            </com.base.common.widget.LsLinearView>

        </com.base.common.widget.LsLinearView>

        <com.base.common.widget.LsTextView
            android:id="@+id/skipButton"
            android:foreground="@drawable/fg_ripple_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="@dimen/_40dp"
            android:paddingHorizontal="@dimen/_12dp"
            android:paddingVertical="@dimen/_8dp"
            android:text="@string/taste_skip"
            android:textColor="@color/hue_on_surface_variant"
            android:textSize="@dimen/text_14sp"
            app:textFont="medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </com.base.common.widget.LsConstraintView>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.base.common.widget.LsLinearView
        android:id="@+id/footer"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:background="@color/hue_surface"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_10dp"
        android:paddingTop="@dimen/_12dp"
        android:paddingBottom="@dimen/_8dp"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.base.common.widget.LsLinearView
            android:id="@+id/primaryButton"
            android:foreground="@drawable/fg_ripple_pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_shape_pill"
            android:backgroundTint="@color/hue_primary"
            android:clickable="true"
            android:elevation="@dimen/_4dp"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/_52dp">

            <ProgressBar
                android:id="@+id/primarySpinner"
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:layout_marginEnd="@dimen/_8dp"
                android:indeterminateTint="@color/hue_on_primary"
                android:visibility="gone" />

            <com.base.common.widget.LsTextView
                android:id="@+id/primaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/taste_continue"
                android:textColor="@color/hue_on_primary"
                android:textSize="@dimen/text_16sp"
                app:textFont="semi" />

            <com.base.common.widget.LsImageView
                android:id="@+id/primaryArrow"
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:layout_marginStart="@dimen/_8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_forward"
                android:tint="@color/hue_on_primary"
                android:visibility="gone" />

        </com.base.common.widget.LsLinearView>

        <com.base.common.widget.LsTextView
            android:id="@+id/secondaryButton"
            android:foreground="@drawable/fg_ripple_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4dp"
            android:gravity="center"
            android:minHeight="@dimen/_40dp"
            android:paddingHorizontal="@dimen/_12dp"
            android:paddingVertical="@dimen/_8dp"
            android:textColor="@color/hue_on_surface_variant"
            android:textSize="@dimen/text_14sp"
            android:visibility="gone"
            app:textFont="medium"
            tools:text="@string/taste_later"
            tools:visibility="visible" />

    </com.base.common.widget.LsLinearView>

</com.base.common.widget.LsConstraintView>
