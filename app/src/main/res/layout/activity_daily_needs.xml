<?xml version="1.0" encoding="utf-8"?>
<!-- The Stitch "Nhu cầu hôm nay - HueTaste" screen: today's meals, budget per meal and a taste note, from Profile. -->
<com.base.common.widget.LsConstraintView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hue_surface"
    tools:context=".feature.daily_needs.DailyNeedsActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/statusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/navigationBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="0dp" />

    <com.base.common.widget.LsLinearView
        android:id="@+id/headerBar"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_10dp"
        android:paddingTop="@dimen/_6dp"
        android:paddingBottom="@dimen/_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/statusBar">

        <com.base.common.widget.LsImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/_44dp"
            android:layout_height="@dimen/_44dp"
            android:background="@drawable/bg_shape_circle"
            android:backgroundTint="@color/hue_surface_lowest"
            android:contentDescription="@string/taste_prefs_back"
            android:foreground="@drawable/fg_ripple_circle"
            android:padding="@dimen/_10dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/hue_on_surface" />

        <com.base.common.widget.LsTextView
            android:layout_width="@dimen/_0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/profile_need_title"
            android:textColor="@color/hue_on_surface"
            android:textSize="@dimen/text_18sp"
            app:textFont="bold" />

    </com.base.common.widget.LsLinearView>

    <com.base.common.widget.LsView
        android:id="@+id/headerDivider"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_1dp"
        android:background="@color/hue_outline_hairline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider">

        <com.base.common.widget.LsLinearView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_10dp"
            android:paddingTop="@dimen/_14dp"
            android:paddingBottom="@dimen/_16dp">

            <com.base.common.widget.LsLinearView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.base.common.widget.LsView
                    android:layout_width="@dimen/_8dp"
                    android:layout_height="@dimen/_8dp"
                    android:background="@drawable/bg_shape_circle"
                    android:backgroundTint="@color/hue_primary" />

                <com.base.common.widget.LsTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8dp"
                    android:letterSpacing="0.12"
                    android:text="@string/daily_needs_kicker"
                    android:textAllCaps="true"
                    android:textColor="@color/hue_primary"
                    android:textSize="@dimen/text_11sp"
                    app:textFont="semi" />

            </com.base.common.widget.LsLinearView>

            <com.base.common.widget.LsTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6dp"
                android:text="@string/daily_needs_title"
                android:textColor="@color/hue_on_surface"
                android:textSize="@dimen/text_24sp"
                app:textFont="bold" />

            <com.base.common.widget.LsTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6dp"
                android:text="@string/daily_needs_subtitle"
                android:textColor="@color/hue_on_surface_variant"
                android:textSize="@dimen/text_14sp"
                app:textFont="regular" />

            <include
                android:id="@+id/status"
                layout="@layout/view_taste_status" />

            <com.base.common.widget.LsLinearView
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Meals -->
                <com.base.common.widget.LsLinearView
                    style="@style/DailyNeedsCard"
                    android:layout_marginTop="@dimen/_20dp">

                    <com.base.common.widget.LsLinearView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.base.common.widget.LsImageView
                            style="@style/DailyNeedsCardIcon"
                            android:backgroundTint="@color/hue_primary_fixed"
                            android:src="@drawable/ic_schedule"
                            android:tint="@color/hue_primary" />

                        <com.base.common.widget.LsTextView
                            style="@style/DailyNeedsCardTitle"
                            android:text="@string/taste_meals_title" />

                        <com.base.common.widget.LsTextView
                            android:id="@+id/mealCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8dp"
                            android:background="@drawable/bg_shape_pill"
                            android:backgroundTint="@color/hue_primary_10"
                            android:paddingHorizontal="@dimen/_10dp"
                            android:paddingVertical="@dimen/_4dp"
                            android:textColor="@color/hue_primary"
                            android:textSize="@dimen/text_11sp"
                            app:textFont="semi"
                            tools:text="3 bữa chọn" />

                    </com.base.common.widget.LsLinearView>

                    <!-- Filled by bindOptions. -->
                    <com.base.common.widget.LsLinearView
                        android:id="@+id/mealList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </com.base.common.widget.LsLinearView>

                <!-- Budget -->
                <com.base.common.widget.LsLinearView
                    style="@style/DailyNeedsCard"
                    android:layout_marginTop="@dimen/_16dp">

                    <com.base.common.widget.LsLinearView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.base.common.widget.LsImageView
                            style="@style/DailyNeedsCardIcon"
                            android:backgroundTint="@color/hue_secondary_container_40"
                            android:src="@drawable/ic_payments"
                            android:tint="@color/hue_secondary" />

                        <com.base.common.widget.LsTextView
                            style="@style/DailyNeedsCardTitle"
                            android:text="@string/taste_budget_title" />

                        <com.base.common.widget.LsTextView
                            android:id="@+id/budgetSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8dp"
                            android:textColor="@color/hue_primary"
                            android:textSize="@dimen/text_12sp"
                            app:textFont="semi"
                            tools:text="30k – 60k" />

                    </com.base.common.widget.LsLinearView>

                    <com.base.common.widget.LsTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8dp"
                        android:text="@string/taste_budget_subtitle"
                        android:textColor="@color/hue_on_surface_variant"
                        android:textSize="@dimen/text_12sp"
                        app:textFont="regular" />

                    <com.base.common.widget.LsLinearView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12dp"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/budgetUnder30"
                            layout="@layout/item_daily_budget_tile"
                            android:layout_width="@dimen/_0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/budget30To60"
                            layout="@layout/item_daily_budget_tile"
                            android:layout_width="@dimen/_0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10dp"
                            android:layout_weight="1" />

                    </com.base.common.widget.LsLinearView>

                    <com.base.common.widget.LsLinearView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10dp"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/budget60To100"
                            layout="@layout/item_daily_budget_tile"
                            android:layout_width="@dimen/_0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/budgetOver100"
                            layout="@layout/item_daily_budget_tile"
                            android:layout_width="@dimen/_0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10dp"
                            android:layout_weight="1" />

                    </com.base.common.widget.LsLinearView>

                </com.base.common.widget.LsLinearView>

                <!-- Note -->
                <com.base.common.widget.LsLinearView
                    style="@style/DailyNeedsCard"
                    android:layout_marginTop="@dimen/_16dp">

                    <com.base.common.widget.LsLinearView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.base.common.widget.LsImageView
                            style="@style/DailyNeedsCardIcon"
                            android:backgroundTint="@color/hue_surface_container_high"
                            android:src="@drawable/ic_edit"
                            android:tint="@color/hue_on_surface_variant" />

                        <com.base.common.widget.LsLinearView
                            android:layout_width="@dimen/_0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.base.common.widget.LsTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/daily_needs_note_title"
                                android:textColor="@color/hue_on_surface"
                                android:textSize="@dimen/text_16sp"
                                app:textFont="semi" />

                            <com.base.common.widget.LsTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/daily_needs_note_subtitle"
                                android:textColor="@color/hue_on_surface_variant"
                                android:textSize="@dimen/text_12sp"
                                app:textFont="regular" />

                        </com.base.common.widget.LsLinearView>

                    </com.base.common.widget.LsLinearView>

                    <com.base.common.widget.LsEditText
                        android:id="@+id/noteInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12dp"
                        android:background="@drawable/bg_auth_field"
                        android:gravity="top|start"
                        android:hint="@string/daily_needs_note_hint"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="200"
                        android:minLines="3"
                        android:padding="@dimen/_14dp"
                        android:textColor="@color/hue_on_surface"
                        android:textColorHint="@color/hue_on_surface_variant"
                        android:textSize="@dimen/text_14sp"
                        app:textFont="regular" />

                    <com.base.common.widget.LsLinearView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.base.common.widget.LsTextView
                            android:id="@+id/noteNoSpicy"
                            style="@style/DailyNeedsQuickNote"
                            android:text="@string/daily_needs_note_add_no_spicy" />

                        <com.base.common.widget.LsTextView
                            android:id="@+id/noteVegetarian"
                            style="@style/DailyNeedsQuickNote"
                            android:layout_marginStart="@dimen/_8dp"
                            android:text="@string/daily_needs_note_add_vegetarian" />

                        <com.base.common.widget.LsTextView
                            android:id="@+id/noteCounter"
                            android:layout_width="@dimen/_0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/hue_on_surface_variant"
                            android:textSize="@dimen/text_11sp"
                            app:textFont="medium"
                            tools:text="0/200" />

                    </com.base.common.widget.LsLinearView>

                </com.base.common.widget.LsLinearView>

            </com.base.common.widget.LsLinearView>

        </com.base.common.widget.LsLinearView>

    </androidx.core.widget.NestedScrollView>

    <com.base.common.widget.LsLinearView
        android:id="@+id/bottomBar"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:background="@color/hue_surface"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_10dp"
        android:paddingTop="@dimen/_12dp"
        android:paddingBottom="@dimen/_8dp"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.base.common.widget.LsTextView
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48dp"
            android:background="@drawable/bg_shape_pill"
            android:backgroundTint="@color/hue_primary"
            android:foreground="@drawable/fg_ripple_pill"
            android:gravity="center"
            android:text="@string/taste_prefs_save"
            android:textColor="@color/hue_on_primary"
            android:textSize="@dimen/text_14sp"
            app:textFont="semi" />

        <com.base.common.widget.LsLinearView
            android:id="@+id/clearButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_40dp"
            android:layout_marginTop="@dimen/_4dp"
            android:foreground="@drawable/fg_ripple_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_16dp">

            <com.base.common.widget.LsImageView
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_delete"
                android:tint="@color/hue_on_surface_variant" />

            <com.base.common.widget.LsTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6dp"
                android:text="@string/daily_needs_clear"
                android:textColor="@color/hue_on_surface_variant"
                android:textSize="@dimen/text_12sp"
                app:textFont="medium" />

        </com.base.common.widget.LsLinearView>

    </com.base.common.widget.LsLinearView>

</com.base.common.widget.LsConstraintView>
