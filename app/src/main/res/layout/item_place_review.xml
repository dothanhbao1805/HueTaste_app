<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:outlineAmbientShadowColor="@color/hue_card_shadow"
    android:outlineSpotShadowColor="@color/hue_card_shadow"
    app:cardBackgroundColor="@color/hue_surface_lowest"
    app:cardCornerRadius="@dimen/_16dp"
    app:cardElevation="@dimen/_2dp"
    app:strokeColor="@color/hue_outline_hairline"
    app:strokeWidth="@dimen/_1dp"
    android:layout_marginTop="@dimen/_12dp">

    <com.base.common.widget.LsLinearView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_12dp">

        <com.base.common.widget.LsLinearView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.base.common.widget.LsFrameView
                android:layout_width="@dimen/_36dp"
                android:layout_height="@dimen/_36dp">

                <com.base.common.widget.LsTextView
                    android:id="@+id/reviewAvatarInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:background="@drawable/bg_shape_circle"
                    android:backgroundTint="@color/hue_secondary_fixed"
                    android:text=""
                    android:textColor="@color/hue_on_secondary_fixed"
                    android:textSize="@dimen/text_16sp"
                    app:textFont="bold" />

                <com.base.common.widget.LsImageView
                    android:id="@+id/reviewAvatarImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.HueTaste.Circle"
                    android:src="@drawable/ic_food_placeholder"
                    android:importantForAccessibility="no" />

            </com.base.common.widget.LsFrameView>

            <com.base.common.widget.LsLinearView
                android:layout_width="@dimen/_0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_10dp">

                <com.base.common.widget.LsTextView
                    android:id="@+id/reviewAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/hue_on_surface"
                    android:textSize="@dimen/text_14sp"
                    app:textFont="semi" />

                <com.base.common.widget.LsTextView
                    android:id="@+id/reviewDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/hue_on_surface_variant"
                    android:textSize="@dimen/text_11sp"
                    app:textFont="regular" />

            </com.base.common.widget.LsLinearView>

        </com.base.common.widget.LsLinearView>

        <com.base.common.widget.LsLinearView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_8dp">

            <com.base.common.widget.LsImageView
                android:id="@+id/reviewStar1"
                android:layout_width="@dimen/_16dp"
                android:layout_height="@dimen/_16dp"
                android:src="@drawable/ic_star"
                android:importantForAccessibility="no" />

            <com.base.common.widget.LsImageView
                android:id="@+id/reviewStar2"
                android:layout_width="@dimen/_16dp"
                android:layout_height="@dimen/_16dp"
                android:src="@drawable/ic_star"
                android:importantForAccessibility="no" />

            <com.base.common.widget.LsImageView
                android:id="@+id/reviewStar3"
                android:layout_width="@dimen/_16dp"
                android:layout_height="@dimen/_16dp"
                android:src="@drawable/ic_star"
                android:importantForAccessibility="no" />

            <com.base.common.widget.LsImageView
                android:id="@+id/reviewStar4"
                android:layout_width="@dimen/_16dp"
                android:layout_height="@dimen/_16dp"
                android:src="@drawable/ic_star"
                android:importantForAccessibility="no" />

            <com.base.common.widget.LsImageView
                android:id="@+id/reviewStar5"
                android:layout_width="@dimen/_16dp"
                android:layout_height="@dimen/_16dp"
                android:src="@drawable/ic_star"
                android:importantForAccessibility="no" />

        </com.base.common.widget.LsLinearView>

        <com.base.common.widget.LsTextView
            android:id="@+id/reviewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:lineSpacingExtra="@dimen/_2dp"
            android:text=""
            android:textColor="@color/hue_on_surface"
            android:textSize="@dimen/text_14sp"
            app:textFont="regular" />

    </com.base.common.widget.LsLinearView>

</com.base.common.widget.LsCardView>
