<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsConstraintView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/forgotRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hue_surface"
    tools:context=".feature.auth.ForgotPasswordActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/statusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/navigationBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="0dp" />

    <com.base.common.widget.LsConstraintView
        android:id="@+id/headerBar"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_64dp"
        android:background="@drawable/bg_header"
        android:paddingHorizontal="@dimen/_10dp"
        app:layout_constraintTop_toTopOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.base.common.widget.LsImageView
            android:id="@+id/backButton"
            android:foreground="@drawable/fg_ripple_circle"
            android:layout_width="@dimen/_48dp"
            android:layout_height="@dimen/_48dp"
            android:contentDescription="@string/context_back"
            android:padding="@dimen/_12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/hue_on_surface"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.base.common.widget.LsTextView
            android:layout_width="@dimen/_0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/forgot_title"
            android:textColor="@color/hue_on_surface"
            android:textSize="@dimen/text_18sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/backButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:textFont="semi" />

    </com.base.common.widget.LsConstraintView>

    <androidx.core.widget.NestedScrollView
        android:overScrollMode="always"
        android:id="@+id/forgotScroll"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.base.common.widget.LsFrameView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/_16dp"
            android:paddingHorizontal="@dimen/_10dp">

            <!-- Step 1: ask for a code by email. -->
            <com.base.common.widget.LsLinearView
                android:id="@+id/emailStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.base.common.widget.LsLinearView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="@dimen/_16dp">

                    <com.base.common.widget.LsFrameView
                        android:layout_width="@dimen/_64dp"
                        android:layout_height="@dimen/_64dp"
                        android:background="@drawable/bg_shape_circle"
                        android:backgroundTint="@color/hue_secondary_fixed_50">

                        <com.base.common.widget.LsImageView
                            android:layout_width="@dimen/_32dp"
                            android:layout_height="@dimen/_32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_lock"
                            android:tint="@color/hue_primary"
                            android:importantForAccessibility="no" />

                    </com.base.common.widget.LsFrameView>

                    <com.base.common.widget.LsTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/_12dp"
                        android:text="@string/forgot_email_heading"
                        android:textColor="@color/hue_primary"
                        android:textSize="@dimen/text_32sp"
                        app:textFont="bold" />

                    <com.base.common.widget.LsTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/_4dp"
                        android:text="@string/forgot_email_subtitle"
                        android:textColor="@color/hue_on_surface_variant"
                        android:textSize="@dimen/text_14sp"
                        app:textFont="regular" />

                </com.base.common.widget.LsLinearView>

                <com.base.common.widget.LsTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24dp"
                    android:paddingStart="@dimen/_8dp"
                    android:labelFor="@id/emailInput"
                    android:text="@string/login_email_label"
                    android:textColor="@color/hue_on_surface"
                    android:textSize="@dimen/text_12sp"
                    app:textFont="semi" />

                <com.base.common.widget.LsLinearView
                    android:id="@+id/emailField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_auth_field"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/_52dp"
                    android:paddingStart="@dimen/_16dp"
                    android:paddingEnd="@dimen/_16dp"
                    android:layout_marginTop="@dimen/_4dp">

                    <com.base.common.widget.LsImageView
                        android:layout_width="@dimen/_22dp"
                        android:layout_height="@dimen/_22dp"
                        android:src="@drawable/ic_mail"
                        android:tint="@color/hue_primary"
                        android:importantForAccessibility="no" />

                    <com.base.common.widget.LsEditText
                        android:id="@+id/emailInput"
                        android:layout_width="@dimen/_0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="@dimen/_8dp"
                        android:background="@null"
                        android:hint="@string/login_email_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:minHeight="@dimen/_48dp"
                        android:textColor="@color/hue_on_surface"
                        android:textColorHint="@color/hue_on_surface_variant"
                        android:textSize="@dimen/text_14sp"
                        app:textFont="regular"
                        android:autofillHints="emailAddress" />

                </com.base.common.widget.LsLinearView>

                <com.base.common.widget.LsLinearView
                    android:id="@+id/emailErrorRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_4dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_12dp"
                    android:visibility="gone">

                    <com.base.common.widget.LsImageView
                        android:layout_width="@dimen/_14dp"
                        android:layout_height="@dimen/_14dp"
                        android:src="@drawable/ic_error"
                        android:tint="@color/hue_error"
                        android:importantForAccessibility="no" />

                    <com.base.common.widget.LsTextView
                        android:id="@+id/emailErrorText"
                        android:layout_width="@dimen/_0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6dp"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="@color/hue_error"
                        android:textSize="@dimen/text_12sp"
                        app:textFont="regular" />

                </com.base.common.widget.LsLinearView>

                <com.base.common.widget.LsLinearView
                    android:id="@+id/sendButton"
                    android:foreground="@drawable/fg_ripple_pill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_shape_pill"
                    android:backgroundTint="@color/hue_primary"
                    android:clickable="true"
                    android:elevation="@dimen/_4dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/_48dp">

                    <ProgressBar
                        android:id="@+id/sendSpinner"
                        android:layout_width="@dimen/_20dp"
                        android:layout_height="@dimen/_20dp"
                        android:layout_marginEnd="@dimen/_8dp"
                        android:indeterminateTint="@color/hue_on_primary"
                        android:visibility="gone" />

                    <com.base.common.widget.LsTextView
                        android:id="@+id/sendText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forgot_send"
                        android:textColor="@color/hue_on_primary"
                        android:textSize="@dimen/text_14sp"
                        app:textFont="semi" />

                </com.base.common.widget.LsLinearView>

            </com.base.common.widget.LsLinearView>

            <!-- Step 2: the 6-digit code from the email. -->
            <com.base.common.widget.LsLinearView
                android:id="@+id/codeStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.base.common.widget.LsLinearView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="@dimen/_16dp">

                    <com.base.common.widget.LsFrameView
                        android:layout_width="@dimen/_64dp"
                        android:layout_height="@dimen/_64dp"
                        android:background="@drawable/bg_shape_circle"
                        android:backgroundTint="@color/hue_secondary_fixed_50">

                        <com.base.common.widget.LsImageView
                            android:layout_width="@dimen/_32dp"
                            android:layout_height="@dimen/_32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_mail"
                            android:tint="@color/hue_primary"
                            android:importantForAccessibility="no" />

                    </com.base.common.widget.LsFrameView>

                    <com.base.common.widget.LsTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/_12dp"
                        android:text="@string/forgot_code_heading"
                        android:textColor="@color/hue_primary"
                        android:textSize="@dimen/text_32sp"
                        app:textFont="bold" />

                    <com.base.common.widget.LsTextView
                        android:id="@+id/sentText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/_4dp"
                        android:text=""
                        android:textColor="@color/hue_on_surface_variant"
                        android:textSize="@dimen/text_14sp"
                        app:textFont="regular" />

                </com.base.common.widget.LsLinearView>

                <!-- One transparent input lies over the six boxes, so typing, deleting, pasting and keyboard
                     code suggestions behave like a normal field; the boxes only show its digits. -->
                <com.base.common.widget.LsFrameView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24dp">

                    <com.base.common.widget.LsLinearView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="horizontal">

                    <com.base.common.widget.LsTextView
                        android:id="@+id/codeBox1"
                        android:layout_width="@dimen/_0dp"
                        android:layout_height="@dimen/_56dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_auth_field"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/hue_on_surface"
                        android:textSize="@dimen/text_24sp"
                        app:textFont="semi" />

                    <com.base.common.widget.LsTextView
                        android:id="@+id/codeBox2"
                        android:layout_width="@dimen/_0dp"
                        android:layout_height="@dimen/_56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_8dp"
                        android:background="@drawable/bg_auth_field"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/hue_on_surface"
                        android:textSize="@dimen/text_24sp"
                        app:textFont="semi" />

                    <com.base.common.widget.LsTextView
                        android:id="@+id/codeBox3"
                        android:layout_width="@dimen/_0dp"
                        android:layout_height="@dimen/_56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_8dp"
                        android:background="@drawable/bg_auth_field"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/hue_on_surface"
                        android:textSize="@dimen/text_24sp"
                        app:textFont="semi" />

                    <com.base.common.widget.LsTextView
                        android:id="@+id/codeBox4"
                        android:layout_width="@dimen/_0dp"
                        android:layout_height="@dimen/_56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_8dp"
                        android:background="@drawable/bg_auth_field"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/hue_on_surface"
                        android:textSize="@dimen/text_24sp"
                        app:textFont="semi" />

                    <com.base.common.widget.LsTextView
                        android:id="@+id/codeBox5"
                        android:layout_width="@dimen/_0dp"
                        android:layout_height="@dimen/_56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_8dp"
                        android:background="@drawable/bg_auth_field"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/hue_on_surface"
                        android:textSize="@dimen/text_24sp"
                        app:textFont="semi" />

                    <com.base.common.widget.LsTextView
                        android:id="@+id/codeBox6"
                        android:layout_width="@dimen/_0dp"
                        android:layout_height="@dimen/_56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_8dp"
                        android:background="@drawable/bg_auth_field"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/hue_on_surface"
                        android:textSize="@dimen/text_24sp"
                        app:textFont="semi" />

                    </com.base.common.widget.LsLinearView>

                    <com.base.common.widget.LsEditText
                        android:id="@+id/codeInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autofillHints="smsOTPCode"
                        android:background="@null"
                        android:contentDescription="@string/forgot_code_label"
                        android:cursorVisible="false"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="yes"
                        android:inputType="number"
                        android:maxLength="6"
                        android:textColor="@android:color/transparent"
                        android:textColorHighlight="@android:color/transparent"
                        android:textSize="@dimen/text_14sp" />

                </com.base.common.widget.LsFrameView>

                <com.base.common.widget.LsLinearView
                    android:id="@+id/codeErrorRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_8dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_12dp"
                    android:visibility="gone">

                    <com.base.common.widget.LsImageView
                        android:layout_width="@dimen/_14dp"
                        android:layout_height="@dimen/_14dp"
                        android:src="@drawable/ic_error"
                        android:tint="@color/hue_error"
                        android:importantForAccessibility="no" />

                    <com.base.common.widget.LsTextView
                        android:id="@+id/codeErrorText"
                        android:layout_width="@dimen/_0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6dp"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="@color/hue_error"
                        android:textSize="@dimen/text_12sp"
                        app:textFont="regular" />

                </com.base.common.widget.LsLinearView>

                <com.base.common.widget.LsTextView
                    android:id="@+id/pasteButton"
                    android:foreground="@drawable/fg_ripple_round_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/_4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/_48dp"
                    android:paddingHorizontal="@dimen/_8dp"
                    android:text="@string/forgot_paste"
                    android:textColor="@color/hue_primary"
                    android:textSize="@dimen/text_14sp"
                    app:textFont="semi" />

                <com.base.common.widget.LsLinearView
                    android:id="@+id/verifyButton"
                    android:foreground="@drawable/fg_ripple_pill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_shape_pill"
                    android:backgroundTint="@color/hue_primary"
                    android:clickable="true"
                    android:elevation="@dimen/_4dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/_48dp">

                    <ProgressBar
                        android:id="@+id/verifySpinner"
                        android:layout_width="@dimen/_20dp"
                        android:layout_height="@dimen/_20dp"
                        android:layout_marginEnd="@dimen/_8dp"
                        android:indeterminateTint="@color/hue_on_primary"
                        android:visibility="gone" />

                    <com.base.common.widget.LsTextView
                        android:id="@+id/verifyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forgot_verify"
                        android:textColor="@color/hue_on_primary"
                        android:textSize="@dimen/text_14sp"
                        app:textFont="semi" />

                </com.base.common.widget.LsLinearView>

                <com.base.common.widget.LsLinearView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.base.common.widget.LsTextView
                        android:id="@+id/resendLink"
                        android:foreground="@drawable/fg_ripple_round_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="@dimen/_48dp"
                        android:paddingHorizontal="@dimen/_8dp"
                        android:text="@string/forgot_resend"
                        android:textColor="@color/hue_primary"
                        android:textSize="@dimen/text_14sp"
                        app:textFont="semi" />

                    <com.base.common.widget.LsTextView
                        android:id="@+id/changeEmailLink"
                        android:foreground="@drawable/fg_ripple_round_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="@dimen/_48dp"
                        android:paddingHorizontal="@dimen/_8dp"
                        android:text="@string/forgot_change_email"
                        android:textColor="@color/hue_primary"
                        android:textSize="@dimen/text_14sp"
                        app:textFont="semi" />

                </com.base.common.widget.LsLinearView>

            </com.base.common.widget.LsLinearView>

            <!-- Step 3: the new password. -->
            <com.base.common.widget.LsLinearView
                android:id="@+id/passwordStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.base.common.widget.LsLinearView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="@dimen/_16dp">

                    <com.base.common.widget.LsFrameView
                        android:layout_width="@dimen/_64dp"
                        android:layout_height="@dimen/_64dp"
                        android:background="@drawable/bg_shape_circle"
                        android:backgroundTint="@color/hue_secondary_fixed_50">

                        <com.base.common.widget.LsImageView
                            android:layout_width="@dimen/_32dp"
                            android:layout_height="@dimen/_32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_lock"
                            android:tint="@color/hue_primary"
                            android:importantForAccessibility="no" />

                    </com.base.common.widget.LsFrameView>

                    <com.base.common.widget.LsTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/_12dp"
                        android:text="@string/forgot_password_heading"
                        android:textColor="@color/hue_primary"
                        android:textSize="@dimen/text_32sp"
                        app:textFont="bold" />

                    <com.base.common.widget.LsTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/_4dp"
                        android:text="@string/forgot_password_subtitle"
                        android:textColor="@color/hue_on_surface_variant"
                        android:textSize="@dimen/text_14sp"
                        app:textFont="regular" />

                </com.base.common.widget.LsLinearView>

                <com.base.common.widget.LsLinearView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_8dp">

                    <com.base.common.widget.LsTextView
                        android:layout_width="@dimen/_0dp"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/passwordInput"
                        android:layout_weight="1"
                        android:text="@string/forgot_password_label"
                        android:textColor="@color/hue_on_surface"
                        android:textSize="@dimen/text_12sp"
                        app:textFont="semi" />

                    <com.base.common.widget.LsTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/register_password_rule"
                        android:textColor="@color/hue_on_surface_variant"
                        android:textSize="@dimen/text_11sp"
                        app:textFont="regular" />

                </com.base.common.widget.LsLinearView>

                <com.base.common.widget.LsLinearView
                    android:id="@+id/passwordField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_auth_field"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/_52dp"
                    android:paddingStart="@dimen/_16dp"
                    android:paddingEnd="@dimen/_0dp"
                    android:layout_marginTop="@dimen/_4dp">

                    <com.base.common.widget.LsImageView
                        android:layout_width="@dimen/_22dp"
                        android:layout_height="@dimen/_22dp"
                        android:src="@drawable/ic_lock"
                        android:tint="@color/hue_primary"
                        android:importantForAccessibility="no" />

                    <com.base.common.widget.LsEditText
                        android:id="@+id/passwordInput"
                        android:layout_width="@dimen/_0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="@dimen/_8dp"
                        android:background="@null"
                        android:hint="@string/register_password_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:minHeight="@dimen/_48dp"
                        android:textColor="@color/hue_on_surface"
                        android:textColorHint="@color/hue_on_surface_variant"
                        android:textSize="@dimen/text_14sp"
                        app:textFont="regular"
                        android:autofillHints="newPassword" />

                    <com.base.common.widget.LsImageView
                        android:id="@+id/passwordToggle"
                        android:foreground="@drawable/fg_ripple_circle"
                        android:layout_width="@dimen/_40dp"
                        android:layout_height="@dimen/_40dp"
                        android:layout_marginEnd="@dimen/_8dp"
                        android:padding="@dimen/_10dp"
                        android:src="@drawable/ic_visibility"
                        android:tint="@color/hue_on_surface_variant"
                        android:contentDescription="@string/auth_show_password" />

                </com.base.common.widget.LsLinearView>

                <com.base.common.widget.LsLinearView
                    android:id="@+id/strengthBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.base.common.widget.LsLinearView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/_8dp"
