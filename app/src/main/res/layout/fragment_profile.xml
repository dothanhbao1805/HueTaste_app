<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsConstraintView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hue_surface">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScroll"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- The 10dp side margin is applied once, here, as in the other tabs. -->
        <com.base.common.widget.LsLinearView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_10dp"
            android:paddingBottom="@dimen/_24dp">

            <com.base.common.widget.LsTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12dp"
                android:accessibilityHeading="true"
                android:text="@string/profile_title"
                android:textColor="@color/hue_on_surface"
                android:textSize="@dimen/text_24sp"
                app:textFont="bold" />

            <!-- Who is signed in; a guest sees an invitation to log in instead. -->
            <com.base.common.widget.LsLinearView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16dp"
                android:background="@drawable/bg_shape_round_16"
                android:backgroundTint="@color/hue_surface_lowest"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/_20dp">

                <com.base.common.widget.LsFrameView
                    android:layout_width="@dimen/_88dp"
                    android:layout_height="@dimen/_88dp"
                    android:background="@drawable/bg_shape_circle"
                    android:backgroundTint="@color/hue_primary_fixed"
                    android:clipToOutline="true">

                    <com.base.common.widget.LsTextView
                        android:id="@+id/avatarInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/hue_primary"
                        android:textSize="@dimen/text_32sp"
                        app:textFont="bold" />

                    <com.base.common.widget.LsImageView
                        android:id="@+id/avatarImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/profile_avatar_description"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <!-- A guest has no name to take the initial from. -->
                    <com.base.common.widget.LsImageView
                        android:id="@+id/avatarGuest"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/_24dp"
                        android:src="@drawable/ic_person"
                        android:tint="@color/hue_primary"
                        android:visibility="gone" />

                </com.base.common.widget.LsFrameView>

                <com.base.common.widget.LsTextView
                    android:id="@+id/nameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12dp"
                    android:gravity="center"
                    android:textColor="@color/hue_on_surface"
                    android:textSize="@dimen/text_18sp"
                    app:textFont="bold" />

                <com.base.common.widget.LsTextView
                    android:id="@+id/detailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2dp"
                    android:gravity="center"
                    android:textColor="@color/hue_on_surface_variant"
                    android:textSize="@dimen/text_14sp"
                    app:textFont="regular" />

                <com.base.common.widget.LsLinearView
                    android:id="@+id/editButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12dp"
                    android:background="@drawable/bg_shape_pill"
                    android:backgroundTint="@color/hue_surface_container_low"
                    android:contentDescription="@string/profile_edit"
                    android:foreground="@drawable/fg_ripple_pill"
                    android:gravity="center"
                    android:minHeight="@dimen/_36dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_14dp"
                    android:paddingVertical="@dimen/_6dp">

                    <com.base.common.widget.LsImageView
                        android:layout_width="@dimen/_16dp"
                        android:layout_height="@dimen/_16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_edit"
                        android:tint="@color/hue_primary" />

                    <com.base.common.widget.LsTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6dp"
                        android:importantForAccessibility="no"
                        android:text="@string/profile_edit"
                        android:textColor="@color/hue_primary"
                        android:textSize="@dimen/text_12sp"
                        app:textFont="semi" />

                </com.base.common.widget.LsLinearView>

                <com.base.common.widget.LsTextView
                    android:id="@+id/guestLoginButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16dp"
                    android:background="@drawable/bg_shape_pill"
                    android:backgroundTint="@color/hue_primary"
                    android:foreground="@drawable/fg_ripple_pill"
                    android:gravity="center"
                    android:minHeight="@dimen/_48dp"
                    android:paddingHorizontal="@dimen/_40dp"
                    android:text="@string/profile_guest_button"
                    android:textColor="@color/hue_on_primary"
                    android:textSize="@dimen/text_14sp"
                    android:visibility="gone"
                    app:textFont="semi" />

            </com.base.common.widget.LsLinearView>

            <!-- Everything below belongs to an account, so a guest does not see it. -->
            <com.base.common.widget.LsLinearView
                android:id="@+id/accountSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.base.common.widget.LsLinearView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_4dp">

                    <com.base.common.widget.LsImageView
                        android:layout_width="@dimen/_16dp"
                        android:layout_height="@dimen/_16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_soup_kitchen"
                        android:tint="@color/hue_tertiary" />

                    <com.base.common.widget.LsTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6dp"
                        android:accessibilityHeading="true"
                        android:letterSpacing="0.05"
                        android:text="@string/profile_section_taste"
                        android:textAllCaps="true"
                        android:textColor="@color/hue_tertiary"
                        android:textSize="@dimen/text_12sp"
                        app:textFont="semi" />

                </com.base.common.widget.LsLinearView>

                <!-- The outline clip keeps the rows' ripples inside the rounded corners. -->
                <com.base.common.widget.LsLinearView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8dp"
                    android:background="@drawable/bg_shape_round_16"
                    android:backgroundTint="@color/hue_surface_lowest"
                    android:clipToOutline="true"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowTaste"
                        layout="@layout/item_profile_row" />

                    <com.base.common.widget.LsView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1dp"
                        android:layout_marginHorizontal="@dimen/_16dp"
                        android:background="@color/hue_surface_container_high" />

                    <include
                        android:id="@+id/rowDiet"
                        layout="@layout/item_profile_row" />

                    <com.base.common.widget.LsView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1dp"
                        android:layout_marginHorizontal="@dimen/_16dp"
                        android:background="@color/hue_surface_container_high" />

                    <include
                        android:id="@+id/rowNeed"
                        layout="@layout/item_profile_row" />

                </com.base.common.widget.LsLinearView>

                <com.base.common.widget.LsLinearView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_4dp">

                    <com.base.common.widget.LsImageView
                        android:layout_width="@dimen/_16dp"
                        android:layout_height="@dimen/_16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_history"
                        android:tint="@color/hue_tertiary" />

                    <com.base.common.widget.LsTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6dp"
                        android:accessibilityHeading="true"
                        android:letterSpacing="0.05"
                        android:text="@string/profile_section_activity"
                        android:textAllCaps="true"
                        android:textColor="@color/hue_tertiary"
                        android:textSize="@dimen/text_12sp"
                        app:textFont="semi" />

                </com.base.common.widget.LsLinearView>

                <!-- The outline clip keeps the rows' ripples inside the rounded corners. -->
                <com.base.common.widget.LsLinearView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8dp"
                    android:background="@drawable/bg_shape_round_16"
                    android:backgroundTint="@color/hue_surface_lowest"
                    android:clipToOutline="true"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowScanHistory"
                        layout="@layout/item_profile_row" />

                    <com.base.common.widget.LsView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1dp"
                        android:layout_marginHorizontal="@dimen/_16dp"
                        android:background="@color/hue_surface_container_high" />

                    <include
                        android:id="@+id/rowReports"
                        layout="@layout/item_profile_row" />

                </com.base.common.widget.LsLinearView>

                <com.base.common.widget.LsLinearView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_4dp">

                    <com.base.common.widget.LsImageView
                        android:layout_width="@dimen/_16dp"
                        android:layout_height="@dimen/_16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_person"
                        android:tint="@color/hue_tertiary" />

                    <com.base.common.widget.LsTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6dp"
                        android:accessibilityHeading="true"
                        android:letterSpacing="0.05"
                        android:text="@string/profile_section_account"
                        android:textAllCaps="true"
                        android:textColor="@color/hue_tertiary"
                        android:textSize="@dimen/text_12sp"
                        app:textFont="semi" />

                </com.base.common.widget.LsLinearView>

                <!-- The outline clip keeps the rows' ripples inside the rounded corners. -->
                <com.base.common.widget.LsLinearView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8dp"
                    android:background="@drawable/bg_shape_round_16"
                    android:backgroundTint="@color/hue_surface_lowest"
                    android:clipToOutline="true"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowPassword"
                        layout="@layout/item_profile_row" />

                    <com.base.common.widget.LsView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1dp"
                        android:layout_marginHorizontal="@dimen/_16dp"
                        android:background="@color/hue_surface_container_high" />

                    <include
                        android:id="@+id/rowLogout"
                        layout="@layout/item_profile_row" />

                </com.base.common.widget.LsLinearView>

            </com.base.common.widget.LsLinearView>

        </com.base.common.widget.LsLinearView>

    </androidx.core.widget.NestedScrollView>

</com.base.common.widget.LsConstraintView>
