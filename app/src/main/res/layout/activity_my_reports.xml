<?xml version="1.0" encoding="utf-8"?>
<!-- The Stitch "Báo cáo của tôi - HueTaste" screen: the user's place reports, with empty and error states. -->
<com.base.common.widget.LsConstraintView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hue_surface"
    tools:context=".feature.my_reports.MyReportsActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/statusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/navigationBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="0dp" />

    <com.base.common.widget.LsLinearView
        android:id="@+id/headerBar"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_10dp"
        android:paddingTop="@dimen/_6dp"
        android:paddingBottom="@dimen/_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/statusBar">

        <com.base.common.widget.LsLinearView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.base.common.widget.LsImageView
                android:id="@+id/backButton"
                android:layout_width="@dimen/_44dp"
                android:layout_height="@dimen/_44dp"
                android:background="@drawable/bg_shape_circle"
                android:backgroundTint="@color/hue_surface_lowest"
                android:contentDescription="@string/my_reports_back"
                android:foreground="@drawable/fg_ripple_circle"
                android:padding="@dimen/_10dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/hue_on_surface" />

            <com.base.common.widget.LsTextView
                android:layout_width="@dimen/_0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/profile_reports_title"
                android:textColor="@color/hue_on_surface"
                android:textSize="@dimen/text_18sp"
                app:textFont="bold" />

        </com.base.common.widget.LsLinearView>

        <!-- Starts under the title: the back button (44dp) plus its 8dp gap. -->
        <com.base.common.widget.LsTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_52dp"
            android:text="@string/profile_reports_subtitle"
            android:textColor="@color/hue_on_surface_variant"
            android:textSize="@dimen/text_12sp"
            app:textFont="regular" />

    </com.base.common.widget.LsLinearView>

    <com.base.common.widget.LsView
        android:id="@+id/headerDivider"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_1dp"
        android:background="@color/hue_outline_hairline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar" />

    <com.base.common.widget.scroll.LsRecyclerView
        android:id="@+id/reportList"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:layout_marginHorizontal="@dimen/_10dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/_14dp"
        android:paddingBottom="@dimen/_24dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        tools:listitem="@layout/item_my_report" />

    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="@dimen/_40dp"
        android:layout_height="@dimen/_40dp"
        android:indeterminateTint="@color/hue_primary"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider" />

    <!-- Shown when the user has not sent any report. -->
    <com.base.common.widget.LsLinearView
        android:id="@+id/emptyView"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        tools:visibility="gone">

        <com.base.common.widget.LsImageView
            android:layout_width="@dimen/_128dp"
            android:layout_height="@dimen/_128dp"
            android:background="@drawable/bg_shape_circle"
            android:backgroundTint="@color/hue_secondary_fixed"
            android:importantForAccessibility="no"
            android:padding="@dimen/_36dp"
            android:src="@drawable/ic_assignment"
            android:tint="@color/hue_primary" />

        <com.base.common.widget.LsTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24dp"
            android:gravity="center"
            android:text="@string/my_reports_empty_title"
            android:textColor="@color/hue_on_surface"
            android:textSize="@dimen/text_16sp"
            app:textFont="bold" />

        <com.base.common.widget.LsTextView
            android:id="@+id/emptyMessage"
            android:layout_width="@dimen/_260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:gravity="center"
            android:textColor="@color/hue_on_surface_variant"
            android:textSize="@dimen/text_14sp"
            app:textFont="regular"
            tools:text="@string/my_reports_empty_message" />

        <com.base.common.widget.LsLinearView
            android:id="@+id/exploreButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_44dp"
            android:layout_marginTop="@dimen/_28dp"
            android:background="@drawable/bg_outline_pill_primary"
            android:foreground="@drawable/fg_ripple_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_20dp">

            <com.base.common.widget.LsImageView
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_storefront"
                android:tint="@color/hue_primary" />

            <com.base.common.widget.LsTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6dp"
                android:text="@string/my_reports_explore"
                android:textColor="@color/hue_primary"
                android:textSize="@dimen/text_14sp"
                app:textFont="semi" />

        </com.base.common.widget.LsLinearView>

    </com.base.common.widget.LsLinearView>

    <!-- Shown when the reports could not be loaded. -->
    <com.base.common.widget.LsLinearView
        android:id="@+id/errorView"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        tools:visibility="gone">

        <com.base.common.widget.LsImageView
            android:layout_width="@dimen/_80dp"
            android:layout_height="@dimen/_80dp"
            android:background="@drawable/bg_shape_circle"
            android:backgroundTint="@color/hue_error_container"
            android:importantForAccessibility="no"
            android:padding="@dimen/_20dp"
            android:src="@drawable/ic_cloud_off"
            android:tint="@color/hue_error" />

        <com.base.common.widget.LsTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20dp"
            android:gravity="center"
            android:text="@string/my_reports_error_title"
            android:textColor="@color/hue_on_surface"
            android:textSize="@dimen/text_16sp"
            app:textFont="bold" />

        <com.base.common.widget.LsTextView
            android:layout_width="@dimen/_260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6dp"
            android:gravity="center"
            android:text="@string/my_reports_error_message"
            android:textColor="@color/hue_on_surface_variant"
            android:textSize="@dimen/text_14sp"
            app:textFont="regular" />

        <com.base.common.widget.LsLinearView
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_44dp"
            android:layout_marginTop="@dimen/_24dp"
            android:background="@drawable/bg_shape_pill"
            android:backgroundTint="@color/hue_primary"
            android:elevation="@dimen/_2dp"
            android:foreground="@drawable/fg_ripple_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_28dp">

            <com.base.common.widget.LsImageView
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_refresh"
                android:tint="@color/hue_on_primary" />

            <com.base.common.widget.LsTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8dp"
                android:text="@string/my_reports_retry"
                android:textColor="@color/hue_on_primary"
                android:textSize="@dimen/text_14sp"
                app:textFont="semi" />

        </com.base.common.widget.LsLinearView>

        <!-- Only for network failures. -->
        <com.base.common.widget.LsLinearView
            android:id="@+id/errorHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.base.common.widget.LsImageView
                android:layout_width="@dimen/_14dp"
                android:layout_height="@dimen/_14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                android:tint="@color/hue_on_surface_variant" />

            <com.base.common.widget.LsTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4dp"
                android:text="@string/my_reports_error_hint"
                android:textColor="@color/hue_on_surface_variant"
                android:textSize="@dimen/text_12sp"
                app:textFont="regular" />

        </com.base.common.widget.LsLinearView>

    </com.base.common.widget.LsLinearView>

</com.base.common.widget.LsConstraintView>
