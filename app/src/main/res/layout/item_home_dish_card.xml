<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/_260dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/_14dp"
    android:clickable="true"
    android:focusable="true"
    android:outlineAmbientShadowColor="@color/hue_card_shadow"
    android:outlineSpotShadowColor="@color/hue_card_shadow"
    app:cardBackgroundColor="@color/hue_surface_lowest"
    app:cardCornerRadius="@dimen/_16dp"
    app:cardElevation="@dimen/_2dp"
    app:rippleColor="@color/navigation_item_ripple"
    app:strokeColor="@color/hue_outline_hairline"
    app:strokeWidth="@dimen/_1dp">

    <com.base.common.widget.LsLinearView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.base.common.widget.LsFrameView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_144dp">

            <com.base.common.widget.LsImageView
                android:id="@+id/dishImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <com.base.common.widget.LsLinearView
                android:id="@+id/matchBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/_10dp"
                android:background="@drawable/bg_home_badge_match"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_8dp"
                android:paddingVertical="@dimen/_2dp">

                <com.base.common.widget.LsImageView
                    android:id="@+id/matchIcon"
                    android:layout_width="@dimen/_14dp"
                    android:layout_height="@dimen/_14dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/hue_on_primary" />

                <com.base.common.widget.LsTextView
                    android:id="@+id/matchText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4dp"
                    android:textColor="@color/hue_on_primary"
                    android:textSize="@dimen/text_11sp"
                    app:textFont="semi" />

            </com.base.common.widget.LsLinearView>

            <com.base.common.widget.LsImageView
                android:id="@+id/favoriteButton"
                android:layout_width="@dimen/_32dp"
                android:layout_height="@dimen/_32dp"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/_10dp"
                android:background="@drawable/bg_home_heart"
                android:contentDescription="@string/home_add_favorite"
                android:foreground="@drawable/fg_ripple_circle"
                android:padding="@dimen/_8dp"
                android:src="@drawable/ic_favorite"
                android:tint="@color/home_heart_tint" />

        </com.base.common.widget.LsFrameView>

        <com.base.common.widget.LsLinearView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_14dp">

            <com.base.common.widget.LsTextView
                android:id="@+id/categoryTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_badge_neutral"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/_8dp"
                android:paddingVertical="@dimen/_2dp"
                android:textColor="@color/hue_on_surface_variant"
                android:textSize="@dimen/text_10sp"
                app:textFont="semi" />

            <com.base.common.widget.LsTextView
                android:id="@+id/dishName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hue_on_surface"
                android:textSize="@dimen/text_16sp"
                app:textFont="semi" />

            <com.base.common.widget.LsTextView
                android:id="@+id/dishReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hue_on_surface_variant"
                android:textSize="@dimen/text_12sp"
                app:textFont="regular" />

            <com.base.common.widget.LsTextView
                android:id="@+id/dishPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hue_primary"
                android:textSize="@dimen/text_16sp"
                app:textFont="bold" />

        </com.base.common.widget.LsLinearView>

    </com.base.common.widget.LsLinearView>

</com.base.common.widget.LsCardView>
