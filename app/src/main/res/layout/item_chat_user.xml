<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsConstraintView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/_6dp">

    <com.base.common.widget.LsImageView
        android:id="@+id/userAvatar"
        android:layout_width="@dimen/_28dp"
        android:layout_height="@dimen/_28dp"
        android:background="@drawable/bg_shape_circle"
        android:backgroundTint="@color/hue_surface_container_highest"
        android:importantForAccessibility="no"
        android:padding="@dimen/_6dp"
        android:src="@drawable/ic_person"
        android:tint="@color/hue_on_surface_variant"
        app:layout_constraintBottom_toBottomOf="@id/messageText"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.base.common.widget.LsTextView
        android:id="@+id/messageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_48dp"
        android:layout_marginEnd="@dimen/_8dp"
        android:background="@drawable/bg_chat_bubble_user"
        android:lineSpacingExtra="@dimen/_4dp"
        android:padding="@dimen/_14dp"
        android:textColor="@color/hue_on_primary"
        android:textSize="@dimen/text_14sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/userAvatar"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textFont="regular" />

    <com.base.common.widget.LsTextView
        android:id="@+id/timeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4dp"
        android:paddingHorizontal="@dimen/_4dp"
        android:textColor="@color/hue_on_surface_variant"
        android:textSize="@dimen/text_11sp"
        app:layout_constraintEnd_toEndOf="@id/messageText"
        app:layout_constraintTop_toBottomOf="@id/messageText"
        app:textFont="medium" />

</com.base.common.widget.LsConstraintView>
