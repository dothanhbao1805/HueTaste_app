<?xml version="1.0" encoding="utf-8"?>
<!-- The Stitch "Gợi ý theo ngữ cảnh" screen: the context of the request, then the suggested dishes or places. -->
<com.base.common.widget.LsConstraintView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contextRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hue_surface"
    tools:context=".feature.context_suggestion.ContextSuggestionActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/statusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/navigationBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="0dp" />

    <com.base.common.widget.LsLinearView
        android:id="@+id/headerBar"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_64dp"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/statusBar">

        <com.base.common.widget.LsImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/_44dp"
            android:layout_height="@dimen/_44dp"
            android:contentDescription="@string/context_back"
            android:foreground="@drawable/fg_ripple_circle"
            android:padding="@dimen/_10dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/hue_on_surface" />

        <com.base.common.widget.LsTextView
            android:layout_width="@dimen/_0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/context_screen_title"
            android:textColor="@color/hue_on_surface"
            android:textSize="@dimen/text_18sp"
            app:textFont="bold" />

    </com.base.common.widget.LsLinearView>

    <!-- 1. Context summary -->
    <com.base.common.widget.LsLinearView
        android:id="@+id/contextCard"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10dp"
        android:layout_marginTop="@dimen/_12dp"
        android:background="@drawable/bg_shape_round_12"
        android:backgroundTint="@color/hue_surface_container_low"
        android:orientation="vertical"
        android:padding="@dimen/_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <com.base.common.widget.LsLinearView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.base.common.widget.LsImageView
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_psychology_alt"
                android:tint="@color/hue_primary" />

            <com.base.common.widget.LsTextView
                android:layout_width="@dimen/_0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/context_header_title"
                android:textColor="@color/hue_primary"
                android:textSize="@dimen/text_16sp"
                app:textFont="semi" />

            <com.base.common.widget.LsLinearView
                android:id="@+id/changeContextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_shape_pill"
                android:backgroundTint="@color/hue_surface_container_high"
                android:foreground="@drawable/fg_ripple_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_12dp"
                android:paddingVertical="@dimen/_6dp">

                <com.base.common.widget.LsTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/context_change"
                    android:textColor="@color/hue_on_surface_variant"
                    android:textSize="@dimen/text_11sp"
                    app:textFont="medium" />

                <com.base.common.widget.LsImageView
                    android:layout_width="@dimen/_16dp"
                    android:layout_height="@dimen/_16dp"
                    android:layout_marginStart="@dimen/_4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tune"
                    android:tint="@color/hue_on_surface_variant" />

            </com.base.common.widget.LsLinearView>

        </com.base.common.widget.LsLinearView>

        <com.base.common.widget.LsConstraintView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp">

            <com.base.common.widget.LsLinearView
                android:id="@+id/tagMeal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_shape_pill"
                android:backgroundTint="@color/hue_primary_fixed"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_10dp"
                android:paddingVertical="@dimen/_4dp">

                <com.base.common.widget.LsImageView
                    android:id="@+id/tagMealIcon"
                    android:layout_width="@dimen/_14dp"
                    android:layout_height="@dimen/_14dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/hue_on_primary_fixed"
                    tools:src="@drawable/ic_wb_twilight" />

                <com.base.common.widget.LsTextView
                    android:id="@+id/tagMealText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4dp"
                    android:textColor="@color/hue_on_primary_fixed"
                    android:textSize="@dimen/text_11sp"
                    app:textFont="medium"
                    tools:text="Bữa sáng" />

            </com.base.common.widget.LsLinearView>

            <com.base.common.widget.LsLinearView
                android:id="@+id/tagBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_shape_pill"
                android:backgroundTint="@color/hue_secondary_fixed"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_10dp"
                android:paddingVertical="@dimen/_4dp">

                <com.base.common.widget.LsImageView
                    android:layout_width="@dimen/_14dp"
                    android:layout_height="@dimen/_14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_payments"
                    android:tint="@color/hue_on_secondary_fixed" />

                <com.base.common.widget.LsTextView
                    android:id="@+id/tagBudgetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4dp"
                    android:textColor="@color/hue_on_secondary_fixed"
                    android:textSize="@dimen/text_11sp"
                    app:textFont="medium"
                    tools:text="Tối đa 50.000 ₫" />

            </com.base.common.widget.LsLinearView>

            <com.base.common.widget.LsLinearView
                android:id="@+id/tagNearby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_shape_pill"
                android:backgroundTint="@color/hue_surface_container_highest"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_10dp"
                android:paddingVertical="@dimen/_4dp">

                <com.base.common.widget.LsImageView
                    android:layout_width="@dimen/_14dp"
                    android:layout_height="@dimen/_14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_near_me"
                    android:tint="@color/hue_on_surface_variant" />

                <com.base.common.widget.LsTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4dp"
                    android:text="@string/context_tag_nearby"
                    android:textColor="@color/hue_on_surface_variant"
                    android:textSize="@dimen/text_11sp"
                    app:textFont="medium" />

            </com.base.common.widget.LsLinearView>

            <com.base.common.widget.LsLinearView
                android:id="@+id/tagWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_shape_pill"
                android:backgroundTint="@color/hue_tertiary_fixed"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_10dp"
                android:paddingVertical="@dimen/_4dp">

                <com.base.common.widget.LsImageView
                    android:layout_width="@dimen/_14dp"
                    android:layout_height="@dimen/_14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_thermostat"
                    android:tint="@color/hue_on_tertiary_fixed" />

                <com.base.common.widget.LsTextView
                    android:id="@+id/tagWeatherText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4dp"
                    android:textColor="@color/hue_on_tertiary_fixed"
                    android:textSize="@dimen/text_11sp"
                    app:textFont="medium"
                    tools:text="24°C se lạnh" />

            </com.base.common.widget.LsLinearView>

            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="@dimen/_0dp"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tagMeal,tagBudget,tagNearby,tagWeather"
                app:flow_horizontalBias="0"
                app:flow_horizontalGap="@dimen/_8dp"
                app:flow_horizontalStyle="packed"
                app:flow_verticalGap="@dimen/_8dp"
                app:flow_wrapMode="chain"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </com.base.common.widget.LsConstraintView>

    </com.base.common.widget.LsLinearView>

    <!-- 2. Dishes / places switch -->
    <com.base.common.widget.LsLinearView
        android:id="@+id/tabBar"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10dp"
        android:layout_marginTop="@dimen/_16dp"
        android:background="@drawable/bg_shape_pill"
        android:backgroundTint="@color/hue_surface_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contextCard">

        <com.base.common.widget.LsLinearView
            android:id="@+id/tabDishes"
            android:layout_width="@dimen/_0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_context_segment"
            android:foreground="@drawable/fg_ripple_pill"
            android:gravity="center"
            android:minHeight="@dimen/_40dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12dp">

            <com.base.common.widget.LsImageView
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ramen_dining"
                android:tint="@color/context_segment_content" />

            <com.base.common.widget.LsTextView
                android:id="@+id/tabDishesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/context_tab_dishes"
                android:textColor="@color/context_segment_content"
                android:textSize="@dimen/text_14sp"
                app:textFont="semi" />

        </com.base.common.widget.LsLinearView>

        <com.base.common.widget.LsLinearView
            android:id="@+id/tabPlaces"
            android:layout_width="@dimen/_0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_context_segment"
            android:foreground="@drawable/fg_ripple_pill"
            android:gravity="center"
            android:minHeight="@dimen/_40dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12dp">

            <com.base.common.widget.LsImageView
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_storefront"
                android:tint="@color/context_segment_content" />

            <com.base.common.widget.LsTextView
                android:id="@+id/tabPlacesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/context_tab_places"
                android:textColor="@color/context_segment_content"
                android:textSize="@dimen/text_14sp"
                app:textFont="semi" />

        </com.base.common.widget.LsLinearView>

    </com.base.common.widget.LsLinearView>

    <!-- 3. Results: one list per tab, so each keeps its own scroll position. -->
    <com.base.common.widget.scroll.LsRecyclerView
        android:overScrollMode="always"
        android:id="@+id/dishList"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:layout_marginHorizontal="@dimen/_10dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/_4dp"
        android:paddingBottom="@dimen/_24dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabBar" />

    <com.base.common.widget.scroll.LsRecyclerView
        android:overScrollMode="always"
        android:id="@+id/placeList"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:layout_marginHorizontal="@dimen/_10dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/_4dp"
        android:paddingBottom="@dimen/_24dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabBar" />

    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="@dimen/_40dp"
        android:layout_height="@dimen/_40dp"
        android:indeterminateTint="@color/hue_primary"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabBar" />

    <!-- Empty tab or failed request; the retry button only shows for a failure. -->
    <com.base.common.widget.LsLinearView
        android:id="@+id/messageView"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabBar"
        tools:visibility="visible">

        <com.base.common.widget.LsImageView
            android:id="@+id/messageIcon"
            android:layout_width="@dimen/_80dp"
            android:layout_height="@dimen/_80dp"
            android:background="@drawable/bg_shape_circle"
            android:importantForAccessibility="no"
            android:padding="@dimen/_20dp"
            tools:backgroundTint="@color/hue_secondary_fixed"
            tools:src="@drawable/ic_ramen_dining"
            tools:tint="@color/hue_primary" />

        <com.base.common.widget.LsTextView
            android:id="@+id/messageText"
            android:layout_width="@dimen/_260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:gravity="center"
            android:textColor="@color/hue_on_surface_variant"
            android:textSize="@dimen/text_14sp"
            app:textFont="regular"
            tools:text="@string/context_dishes_empty" />

        <com.base.common.widget.LsLinearView
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_44dp"
            android:layout_marginTop="@dimen/_20dp"
            android:background="@drawable/bg_shape_pill"
            android:backgroundTint="@color/hue_primary"
            android:foreground="@drawable/fg_ripple_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_28dp">

            <com.base.common.widget.LsImageView
                android:layout_width="@dimen/_18dp"
                android:layout_height="@dimen/_18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_refresh"
                android:tint="@color/hue_on_primary" />

            <com.base.common.widget.LsTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8dp"
                android:text="@string/my_reports_retry"
                android:textColor="@color/hue_on_primary"
                android:textSize="@dimen/text_14sp"
                app:textFont="semi" />

        </com.base.common.widget.LsLinearView>

    </com.base.common.widget.LsLinearView>

</com.base.common.widget.LsConstraintView>
