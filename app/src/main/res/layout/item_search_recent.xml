<?xml version="1.0" encoding="utf-8"?>
<!-- One recent search: tap the term to search it again, the cross to forget it. -->
<com.base.common.widget.LsLinearView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.base.common.widget.LsTextView
        android:id="@+id/recentTerm"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:drawableStart="@drawable/ic_schedule"
        android:drawablePadding="@dimen/_10dp"
        android:drawableTint="@color/hue_on_surface_variant"
        android:ellipsize="end"
        android:focusable="true"
        android:foreground="@drawable/fg_ripple_round_8"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:minHeight="@dimen/_44dp"
        android:paddingHorizontal="@dimen/_8dp"
        android:textColor="@color/hue_on_surface"
        android:textSize="@dimen/text_14sp"
        app:textFont="regular" />

    <com.base.common.widget.LsImageView
        android:id="@+id/recentRemove"
        android:layout_width="@dimen/_40dp"
        android:layout_height="@dimen/_40dp"
        android:foreground="@drawable/fg_ripple_circle"
        android:padding="@dimen/_12dp"
        android:src="@drawable/ic_close"
        android:tint="@color/hue_on_surface_variant" />

</com.base.common.widget.LsLinearView>
