<?xml version="1.0" encoding="utf-8"?>
<!-- One dish of a reply: backend monAn[] item (hinhAnh, tenMon, giaThamKhaoTu/Den, diemSo, lyDoGiaiThich). -->
<com.base.common.widget.LsCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/_220dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/_12dp"
    android:clickable="true"
    android:focusable="true"
    android:outlineAmbientShadowColor="@color/hue_card_shadow"
    android:outlineSpotShadowColor="@color/hue_card_shadow"
    app:cardBackgroundColor="@color/hue_surface_lowest"
    app:cardCornerRadius="@dimen/_16dp"
    app:cardElevation="@dimen/_1dp"
    app:rippleColor="@color/navigation_item_ripple"
    app:strokeColor="@color/hue_outline_hairline"
    app:strokeWidth="@dimen/_1dp">

    <com.base.common.widget.LsLinearView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.base.common.widget.LsFrameView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_120dp">

            <com.base.common.widget.LsImageView
                android:id="@+id/dishImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/ai_chat_dish_photo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_food_placeholder" />

            <com.base.common.widget.LsTextView
                android:id="@+id/matchBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/_8dp"
                android:background="@drawable/bg_shape_pill"
                android:backgroundTint="@color/hue_secondary_container"
                android:paddingHorizontal="@dimen/_8dp"
                android:paddingVertical="@dimen/_4dp"
                android:textColor="@color/hue_on_secondary_container"
                android:textSize="@dimen/text_11sp"
                app:textFont="bold" />

        </com.base.common.widget.LsFrameView>

        <com.base.common.widget.LsLinearView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_12dp">

            <com.base.common.widget.LsTextView
                android:id="@+id/dishName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hue_on_surface"
                android:textSize="@dimen/text_16sp"
                app:textFont="semi" />

            <com.base.common.widget.LsTextView
                android:id="@+id/dishPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:textColor="@color/hue_primary"
                android:textSize="@dimen/text_14sp"
                app:textFont="bold" />

            <com.base.common.widget.LsTextView
                android:id="@+id/dishReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4dp"
                android:ellipsize="end"
                android:lines="2"
                android:textColor="@color/hue_on_surface_variant"
                android:textSize="@dimen/text_12sp"
                app:textFont="regular" />

        </com.base.common.widget.LsLinearView>

    </com.base.common.widget.LsLinearView>

</com.base.common.widget.LsCardView>
