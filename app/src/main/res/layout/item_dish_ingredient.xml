<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsLinearView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_8dp"
    android:background="@drawable/bg_shape_round_12"
    android:backgroundTint="@color/hue_surface_container_low"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/_10dp">

    <com.base.common.widget.LsFrameView
        android:id="@+id/ingredientIconBackground"
        android:layout_width="@dimen/_32dp"
        android:layout_height="@dimen/_32dp"
        android:background="@drawable/bg_shape_circle"
        android:backgroundTint="@color/hue_primary_fixed">

        <com.base.common.widget.LsImageView
            android:id="@+id/ingredientIcon"
            android:layout_width="@dimen/_18dp"
            android:layout_height="@dimen/_18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_kettle"
            android:tint="@color/hue_primary" />

    </com.base.common.widget.LsFrameView>

    <com.base.common.widget.LsLinearView
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.base.common.widget.LsTextView
            android:id="@+id/ingredientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/hue_on_surface"
            android:textSize="@dimen/text_14sp"
            app:textFont="semi" />

        <com.base.common.widget.LsTextView
            android:id="@+id/ingredientGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/hue_on_surface_variant"
            android:textSize="@dimen/text_12sp"
            app:textFont="regular" />

    </com.base.common.widget.LsLinearView>

    <com.base.common.widget.LsTextView
        android:id="@+id/ingredientRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8dp"
        android:background="@drawable/bg_shape_round_6"
        android:backgroundTint="@color/hue_primary"
        android:paddingHorizontal="@dimen/_8dp"
        android:paddingVertical="@dimen/_2dp"
        android:textColor="@color/hue_on_primary"
        android:textSize="@dimen/text_11sp"
        app:textFont="medium" />

</com.base.common.widget.LsLinearView>
