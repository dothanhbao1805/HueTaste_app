<?xml version="1.0" encoding="utf-8"?>
<!-- A dish flagged in a report and the admins' verdict for it; colors are set by MyReportAdapter. -->
<com.base.common.widget.LsLinearView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_6dp"
    android:background="@drawable/bg_shape_round_6"
    android:backgroundTint="@color/hue_surface_container"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/_10dp"
    android:paddingVertical="@dimen/_6dp">

    <com.base.common.widget.LsTextView
        android:id="@+id/dishName"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/hue_on_surface"
        android:textSize="@dimen/text_12sp"
        app:textFont="medium"
        tools:text="Chả tôm cuốn" />

    <com.base.common.widget.LsImageView
        android:id="@+id/resultIcon"
        android:layout_width="@dimen/_14dp"
        android:layout_height="@dimen/_14dp"
        android:layout_marginStart="@dimen/_8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_hourglass_empty"
        android:tint="@color/hue_on_surface_variant" />

    <com.base.common.widget.LsTextView
        android:id="@+id/resultText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_2dp"
        android:text="@string/my_reports_dish_pending"
        android:textColor="@color/hue_on_surface_variant"
        android:textSize="@dimen/text_11sp"
        app:textFont="medium" />

</com.base.common.widget.LsLinearView>
