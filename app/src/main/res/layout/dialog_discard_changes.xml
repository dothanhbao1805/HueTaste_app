<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsFrameView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_24dp">

    <com.base.common.widget.LsLinearView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_shape_round_16"
        android:backgroundTint="@color/hue_surface_lowest"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/_24dp">

        <com.base.common.widget.LsImageView
            android:layout_width="@dimen/_48dp"
            android:layout_height="@dimen/_48dp"
            android:background="@drawable/bg_shape_circle"
            android:backgroundTint="@color/hue_secondary_fixed"
            android:importantForAccessibility="no"
            android:padding="@dimen/_12dp"
            android:src="@drawable/ic_info"
            android:tint="@color/hue_primary" />

        <com.base.common.widget.LsTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14dp"
            android:gravity="center"
            android:text="@string/discard_changes_title"
            android:textColor="@color/hue_on_surface"
            android:textSize="@dimen/text_18sp"
            app:textFont="bold" />

        <com.base.common.widget.LsTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:gravity="center"
            android:text="@string/discard_changes_message"
            android:textColor="@color/hue_on_surface_variant"
            android:textSize="@dimen/text_14sp"
            app:textFont="regular" />

        <com.base.common.widget.LsTextView
            android:id="@+id/stayButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48dp"
            android:layout_marginTop="@dimen/_24dp"
            android:background="@drawable/bg_shape_pill"
            android:backgroundTint="@color/hue_primary"
            android:foreground="@drawable/fg_ripple_pill"
            android:gravity="center"
            android:text="@string/discard_changes_stay"
            android:textColor="@color/hue_on_primary"
            android:textSize="@dimen/text_14sp"
            app:textFont="semi" />

        <com.base.common.widget.LsTextView
            android:id="@+id/discardButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48dp"
            android:layout_marginTop="@dimen/_10dp"
            android:background="@drawable/bg_dialog_cancel"
            android:gravity="center"
            android:text="@string/discard_changes_confirm"
            android:textColor="@color/hue_primary"
            android:textSize="@dimen/text_14sp"
            app:textFont="semi" />

    </com.base.common.widget.LsLinearView>

</com.base.common.widget.LsFrameView>
