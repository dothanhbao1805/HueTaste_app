<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsLinearView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_10dp"
    android:background="@drawable/bg_shape_round_12"
    android:backgroundTint="@color/hue_surface_lowest"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/_12dp">

    <com.base.common.widget.LsFrameView
        android:layout_width="@dimen/_44dp"
        android:layout_height="@dimen/_44dp"
        android:background="@drawable/bg_shape_circle"
        android:backgroundTint="@color/hue_primary_10">

        <com.base.common.widget.LsImageView
            android:id="@+id/tipIcon"
            android:layout_width="@dimen/_24dp"
            android:layout_height="@dimen/_24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:tint="@color/hue_primary"
            app:colorTint="none" />
    </com.base.common.widget.LsFrameView>

    <com.base.common.widget.LsTextView
        android:id="@+id/tipText"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12dp"
        android:layout_weight="1"
        android:textColor="@color/hue_on_surface"
        android:textSize="@dimen/text_14sp"
        app:textFont="regular" />

</com.base.common.widget.LsLinearView>
