<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsLinearView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_8dp"
    android:background="@drawable/bg_shape_round_12"
    android:backgroundTint="@color/hue_surface_container_low"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_48dp"
    android:orientation="horizontal"
    android:padding="@dimen/_8dp">

    <com.base.common.widget.LsImageView
        android:id="@+id/similarImage"
        android:layout_width="@dimen/_56dp"
        android:layout_height="@dimen/_56dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_food_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.HueTaste.Rounded12" />

    <com.base.common.widget.LsLinearView
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.base.common.widget.LsTextView
            android:id="@+id/similarName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hue_on_surface"
            android:textSize="@dimen/text_14sp"
            app:textFont="semi" />

        <com.base.common.widget.LsTextView
            android:id="@+id/similarDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/hue_on_surface_variant"
            android:textSize="@dimen/text_12sp"
            app:textFont="regular" />

    </com.base.common.widget.LsLinearView>

    <com.base.common.widget.LsImageView
        android:layout_width="@dimen/_20dp"
        android:layout_height="@dimen/_20dp"
        android:layout_marginStart="@dimen/_8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/hue_on_surface_variant" />

</com.base.common.widget.LsLinearView>
