<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsLinearView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_8dp"
    android:background="@drawable/bg_shape_round_12"
    android:backgroundTint="@color/hue_surface_container_low"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/fg_ripple_round_12"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_64dp"
    android:orientation="horizontal"
    android:padding="@dimen/_8dp">

    <com.base.common.widget.LsImageView
        android:id="@+id/quickPlaceImage"
        android:layout_width="@dimen/_48dp"
        android:layout_height="@dimen/_48dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.HueTaste.Rounded8" />

    <com.base.common.widget.LsLinearView
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.base.common.widget.LsTextView
            android:id="@+id/quickPlaceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hue_on_surface"
            android:textSize="@dimen/text_14sp"
            app:textFont="semi" />

        <com.base.common.widget.LsTextView
            android:id="@+id/quickPlacePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hue_primary"
            android:textSize="@dimen/text_12sp"
            app:textFont="semi" />

    </com.base.common.widget.LsLinearView>

    <com.base.common.widget.LsImageView
        android:id="@+id/quickPlaceStar"
        android:layout_width="@dimen/_16dp"
        android:layout_height="@dimen/_16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_star"
        android:tint="@color/hue_secondary_container" />

    <com.base.common.widget.LsTextView
        android:id="@+id/quickPlaceRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_2dp"
        android:layout_marginEnd="@dimen/_4dp"
        android:textColor="@color/hue_on_surface"
        android:textSize="@dimen/text_12sp"
        app:textFont="semi" />

</com.base.common.widget.LsLinearView>
