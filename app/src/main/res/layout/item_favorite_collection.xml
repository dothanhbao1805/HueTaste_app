<?xml version="1.0" encoding="utf-8"?>
<com.base.common.widget.LsCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/_140dp"
    android:layout_height="@dimen/_96dp"
    android:layout_marginEnd="@dimen/_10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/hue_surface_container_high"
    app:cardCornerRadius="@dimen/_16dp"
    app:cardElevation="@dimen/_0dp"
    app:rippleColor="@color/navigation_item_ripple"
    app:strokeColor="@color/hue_outline_hairline"
    app:strokeWidth="@dimen/_1dp">

    <com.base.common.widget.LsFrameView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.base.common.widget.LsImageView
            android:id="@+id/collectionCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <com.base.common.widget.LsView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_dish_scrim" />

        <com.base.common.widget.LsLinearView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/_10dp">

            <com.base.common.widget.LsTextView
                android:id="@+id/collectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hue_on_primary"
                android:textSize="@dimen/text_14sp"
                app:textFont="bold" />

            <com.base.common.widget.LsTextView
                android:id="@+id/collectionCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hue_on_primary"
                android:textSize="@dimen/text_11sp"
                app:textFont="medium" />

        </com.base.common.widget.LsLinearView>

    </com.base.common.widget.LsFrameView>

</com.base.common.widget.LsCardView>
