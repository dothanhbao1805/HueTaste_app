<?xml version="1.0" encoding="utf-8"?>
<!-- A dish of the search results: photo, name, description, meal and weather pills, price and how many places sell it. -->
<com.base.common.widget.LsCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:outlineAmbientShadowColor="@color/hue_card_shadow"
    android:outlineSpotShadowColor="@color/hue_card_shadow"
    app:cardBackgroundColor="@color/hue_surface_lowest"
    app:cardCornerRadius="@dimen/_16dp"
    app:cardElevation="@dimen/_2dp"
    app:rippleColor="@color/navigation_item_ripple"
    app:strokeColor="@color/hue_outline_hairline"
    app:strokeWidth="@dimen/_1dp">

    <com.base.common.widget.LsLinearView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_12dp">

        <com.base.common.widget.LsFrameView
            android:layout_width="@dimen/_96dp"
            android:layout_height="@dimen/_96dp">

            <com.base.common.widget.LsImageView
                android:id="@+id/dishImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/hue_surface_container_high"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.HueTaste.Rounded12" />

            <com.base.common.widget.LsTextView
                android:id="@+id/dishSignature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/_4dp"
                android:background="@drawable/bg_home_badge_gold"
                android:paddingHorizontal="@dimen/_6dp"
                android:paddingVertical="@dimen/_2dp"
                android:text="@string/search_dish_signature"
                android:textColor="@color/hue_on_secondary_container"
                android:textSize="@dimen/text_10sp"
                app:textFont="bold" />

        </com.base.common.widget.LsFrameView>

        <com.base.common.widget.LsLinearView
            android:layout_width="@dimen/_0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.base.common.widget.LsLinearView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.base.common.widget.LsTextView
                    android:id="@+id/dishName"
                    android:layout_width="@dimen/_0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/hue_on_surface"
                    android:textSize="@dimen/text_16sp"
                    app:textFont="semi" />

                <com.base.common.widget.LsImageView
                    android:id="@+id/favoriteButton"
                    android:layout_width="@dimen/_40dp"
                    android:layout_height="@dimen/_40dp"
                    android:layout_marginStart="@dimen/_4dp"
                    android:foreground="@drawable/fg_ripple_circle"
                    android:padding="@dimen/_10dp"
                    android:src="@drawable/ic_favorite"
                    android:tint="@color/home_heart_tint" />

            </com.base.common.widget.LsLinearView>

            <com.base.common.widget.LsTextView
                android:id="@+id/dishDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/hue_on_surface_variant"
                android:textSize="@dimen/text_12sp"
                app:textFont="regular" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/dishTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6dp"
                app:chipSpacingHorizontal="@dimen/_4dp"
                app:chipSpacingVertical="@dimen/_4dp" />

            <com.base.common.widget.LsView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1dp"
                android:layout_marginTop="@dimen/_8dp"
                android:background="@color/hue_surface_container_low" />

            <com.base.common.widget.LsLinearView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.base.common.widget.LsTextView
                    android:id="@+id/dishPrice"
                    android:layout_width="@dimen/_0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/hue_primary"
                    android:textSize="@dimen/text_14sp"
                    app:textFont="bold" />

                <com.base.common.widget.LsImageView
                    android:id="@+id/dishPlaceIcon"
                    android:layout_width="@dimen/_14dp"
                    android:layout_height="@dimen/_14dp"
                    android:layout_marginStart="@dimen/_8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_store"
                    android:tint="@color/hue_secondary" />

                <com.base.common.widget.LsTextView
                    android:id="@+id/dishPlaceCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_2dp"
                    android:textColor="@color/hue_on_surface_variant"
                    android:textSize="@dimen/text_11sp"
                    app:textFont="regular" />

            </com.base.common.widget.LsLinearView>

        </com.base.common.widget.LsLinearView>

    </com.base.common.widget.LsLinearView>

</com.base.common.widget.LsCardView>
