<?xml version="1.0" encoding="utf-8"?>
<!-- The "Khẩu vị cố đô" label above each taste setup page title. -->
<com.base.common.widget.LsLinearView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_8dp"
    android:background="@drawable/bg_home_pill_gold"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/_12dp"
    android:paddingVertical="@dimen/_6dp">

    <com.base.common.widget.LsImageView
        android:layout_width="@dimen/_16dp"
        android:layout_height="@dimen/_16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tune"
        android:tint="@color/hue_secondary" />

    <com.base.common.widget.LsTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_6dp"
        android:text="@string/taste_badge"
        android:textAllCaps="true"
        android:textColor="@color/hue_secondary"
        android:textSize="@dimen/text_12sp"
        app:textFont="bold" />

</com.base.common.widget.LsLinearView>
